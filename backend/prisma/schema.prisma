generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// KATEGORİ TÜRÜ
enum CategoryType {
  SPORTS
  SOCIAL
  ARTS
  GAMES
}

// KULLANICI
model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  phone       String?   @unique
  username    String    @unique
  password    String
  fullName    String?
  avatar      String?
  bio         String?
  birthDate   DateTime?
  country     String?
  city        String?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // İlişkiler
  interests        UserInterest[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  playlists        Playlist[]
  likedTracks      LikedTrack[]
  followers        Follow[]  @relation("following")
  following        Follow[]  @relation("follower")
  sentRequests     ActivityRequest[] @relation("sender")
  receivedRequests ActivityRequest[] @relation("receiver")
  tournaments      TournamentParticipant[]
  tournamentTypeVotes TournamentTypeVote[]
  createdTournaments Tournament[] @relation("tournamentCreator")
  events           EventParticipant[]
  cards            ActivityCard[]
  courts           Court[]
  gender           String?  // MALE | FEMALE | OTHER
  // Gizlilik modlari: PUBLIC | FRIENDS | FOLLOWERS | FRIENDS_EXCEPT | FRIENDS_SELECTED
  // *Exclude alani moda gore yeniden yorumlanir: FRIENDS_EXCEPT -> haric tutulanlar, FRIENDS_SELECTED -> sadece dahil edilenler
  profilePrivacy   String   @default("PUBLIC")
  profileExclude   Json     @default("[]")        // [userId, ...]
  fullNamePrivacy  String   @default("PUBLIC")
  fullNameExclude  Json     @default("[]")
  cityPrivacy      String   @default("PUBLIC")
  genderPrivacy    String   @default("PUBLIC")
  birthDatePrivacy String   @default("PUBLIC")
  cityExclude      Json     @default("[]")
  genderExclude    Json     @default("[]")
  birthDateExclude Json     @default("[]")
  postsPrivacy        String @default("PUBLIC")
  postsExclude        Json   @default("[]")
  reelsPrivacy        String @default("PUBLIC")
  reelsExclude        Json   @default("[]")
  friendsListPrivacy  String @default("PUBLIC")
  friendsListExclude  Json   @default("[]")
  activitiesPrivacy   String @default("PUBLIC")
  activitiesExclude   Json   @default("[]")
  likesCommentsPrivacy String @default("PUBLIC")
  likesCommentsExclude Json   @default("[]")
  isAdmin                Boolean  @default(false)
  isBusiness             Boolean  @default(false)
  businessName           String?
  taxNumber              String?
  businessAddress        String?
  lateCancelCount        Int      @default(0)
  tournamentBanRemaining Int      @default(0)
  pushToken              String?
  rivalJoinReqs    RivalJoinRequest[]
  notifications    Notification[]
  sentFriendReqs   Friendship[] @relation("friendshipSender")
  receivedFriendReqs Friendship[] @relation("friendshipReceiver")
  blockedUsers     Block[] @relation("blocker")
  blockedBy        Block[] @relation("blocked")
  sentMessages     Message[]
  tournamentMessages TournamentMessage[]
  tournamentChatNotifyPrefs TournamentChatNotify[]
  conversations1   Conversation[] @relation("convUser1")
  conversations2   Conversation[] @relation("convUser2")
  storyViews       StoryView[]
  assessmentVotesCast AssessmentVote[]
  coachListings       CoachListing[]
  refereeListings     RefereeListing[]
  refereedMatches     ActivityRequest[] @relation("MatchRefereeUser")
  coachLessonRequests CoachLessonRequest[] @relation("CoachLessonStudent")
  coachReviewsGiven   CoachReview[] @relation("CoachReviewer")
  refereeReviewsGiven RefereeReview[] @relation("RefereeReviewer")
  equipmentListings   EquipmentListing[]
  equipmentOffers     EquipmentOffer[]
  listingReports      ListingReport[]
  userAchievements    UserAchievement[]
  matchComments    MatchComment[]
  noShowReports    NoShowReport[] @relation("noShowReporter")
  peerReviewsGiven    MatchPeerReview[] @relation("PeerReviewGiven")
  peerReviewsReceived MatchPeerReview[] @relation("PeerReviewReceived")
  cityAlerts       CityAlert[]
  activityAlert    ActivityAlert?
  notifiedExternalEvents NotifiedExternalEvent[]
  surveyGiven      SportSurvey[] @relation("SurveyRater")
  surveyReceived   SportSurvey[] @relation("SurveySubject")
  profileChangeRequests ProfileChangeRequest[]
  supportMessages       SupportMessage[]
  subscriptions         BusinessSubscription[]
  subscriptionRequests  SubscriptionRequest[]
  businessIban          String?
  businessIbanHolder    String?
  venues                BusinessVenue[]
  contactPhone       String?
  contactTelegram    String?
  contactEmail       String?
  contactInstagram   String?
  phonePrivacy       String  @default("FRIENDS")
  phoneSelected      Json    @default("[]")
  telegramPrivacy    String  @default("FRIENDS")
  telegramSelected   Json    @default("[]")
  cEmailPrivacy      String  @default("FRIENDS")
  cEmailSelected     Json    @default("[]")
  instagramPrivacy   String  @default("PUBLIC")
  instagramSelected  Json    @default("[]")
  courtReservations     CourtReservation[]
  venueBlocks           VenueBlock[]       @relation("BlockedUser")
  venueOrders           VenueOrder[]
  venueReviews          VenueReview[]
  courtRatings          CourtRating[]
  reviewAppeals         ReviewAppeal[]

  // Arkadaş Bulma (konum bazlı eşleştirme)
  lat                  Float?
  lng                  Float?
  locationUpdatedAt    DateTime?
  locationPrivacy      String    @default("FRIENDS")
  locationExclude      Json      @default("[]")
  friendFindingProfile FriendFindingProfile?
  ffSwipesGiven        FriendFindingSwipe[] @relation("FFSwiper")
  ffSwipesReceived     FriendFindingSwipe[] @relation("FFTarget")
  ffMatchesAsUser1     FriendFindingMatch[] @relation("FFMatchUser1")
  ffMatchesAsUser2     FriendFindingMatch[] @relation("FFMatchUser2")

  @@index([lat, lng])
}

model ProfileChangeRequest {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field        String   // 'fullName' | 'gender' | 'birthDate'
  currentValue String?
  newValue     String?
  documentUrl  String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// KULLANICIDAN ADMİNE DESTEK MESAJI
model SupportMessage {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  status     String   @default("PENDING") // PENDING | ANSWERED
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SportSurvey {
  id          String   @id @default(cuid())
  subjectId   String
  raterId     String
  subCategory String
  stres       Int
  fairplay    Int
  beden       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     User     @relation("SurveySubject", fields: [subjectId], references: [id], onDelete: Cascade)
  rater       User     @relation("SurveyRater",   fields: [raterId],   references: [id], onDelete: Cascade)
  @@unique([subjectId, raterId, subCategory])
}

model TournamentPermissionRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// KULLANICI İLGİ ALANLARI (Kategori + Alt Dal)
model UserInterest {
  id           String       @id @default(uuid())
  userId       String
  category     CategoryType
  subCategory  String       // futbol, basketbol, resim, müzik, fps, rpg vb.
  level        String       @default("BEGINNER")
  skillRating  Float        @default(0)   // 0.00 – 5.00, from assessment
  assessmentCompleted Boolean @default(false)  // anket tamamlanmadan maca katilamaz
  matchesSinceAssessment Int @default(0)  // tenis/padel: anketten sonra oynanan maç sayısı (0-3, ilk 3 maç doğrulama penceresi)
  totalPoints  Int          @default(0)
  walletPoints Int          @default(2000)  // okey/batak gibi bahisli oyunlar icin harcanabilir puan bakiyesi
  wins             Int          @default(0)
  losses           Int          @default(0)
  lateCancelCount  Int          @default(0)  // unilateral cancels within 5h of match
  alias        String?      // sport-specific display name shown in listings
  hidden       Boolean      @default(false)  // 3+ maci olan branslar silinemez, sadece gizlenir (puan/gecmis korunur)
  trustScore   Float        @default(1.0)  // 0.2-1.0, akran oyu verirken guvenilirlik (bkz. MatchPeerReview)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            Skill[]
  assessmentVotes   AssessmentVote[] @relation("VoteTarget")

  digimonVotingEnabled Boolean @default(false)

  @@unique([userId, category, subCategory])
}

// ASSESSMENT OYLAMA (digimon kart oy sistemi)
model AssessmentVote {
  id               String       @id @default(uuid())
  voterId          String
  targetInterestId String
  questionId       String
  optionIndex      Int
  createdAt        DateTime     @default(now())

  voter            User         @relation(fields: [voterId], references: [id], onDelete: Cascade)
  targetInterest   UserInterest @relation("VoteTarget", fields: [targetInterestId], references: [id], onDelete: Cascade)

  @@unique([voterId, targetInterestId, questionId])
}

// YETENEK
model Skill {
  id         String   @id @default(uuid())
  interestId String
  name       String
  value      Int      @default(0)
  createdAt  DateTime @default(now())

  interest   UserInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)
}

// ANTRENÖR İLANI
model CoachListing {
  id              String   @id @default(uuid())
  userId          String
  category        String   // SPORTS / ARTS / GAMES
  subCategory     String   // tennis, padel, etc.

  // Kimlik / Belge
  credentialLevel String   // CERTIFIED | LICENSED | CLUB_COACH | INDEPENDENT | AMATEUR
  certName        String?  // "ITF Level 2", "PTR Professional" vb.
  certificateUrl  String?  // yuklenen belge/sertifika dosyasi (pdf veya foto)
  experience      Int      @default(0) // years
  achievements    String?  // basarilar - yazili bilgi
  achievementUrls Json     @default("[]") // basari belgesi/foto dosyalari
  cvUrl           String?  // yuklenen CV dosyasi

  // Ders tipleri
  individual      Boolean  @default(true)
  group           Boolean  @default(false)
  priceIndividual Int      @default(0)   // per hour, local currency
  priceGroup      Int      @default(0)   // per person per session
  maxGroupSize    Int      @default(4)

  // Yer / Zaman
  location        String
  city            String?
  days            Json     @default("[]") // ["MON","TUE",...]
  timeFrom        String   @default("09:00")
  timeTo          String   @default("21:00")

  description     String?
  status          String   @default("ACTIVE")  // ACTIVE | FLAGGED | REMOVED
  reportCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonRequests  CoachLessonRequest[]
  reviews         CoachReview[]
}

// Öğrencinin antrenörle "ders aldım" ilişkisini kurması — antrenör kabul edince
// öğrenci o antrenöre yorum/yıldız verebilir hale gelir (bkz. CoachReview).
model CoachLessonRequest {
  id             String   @id @default(uuid())
  coachListingId String
  studentId      String
  status         String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  message        String?
  createdAt      DateTime @default(now())

  coachListing   CoachListing @relation(fields: [coachListingId], references: [id], onDelete: Cascade)
  student        User         @relation("CoachLessonStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([coachListingId, studentId])
}

model CoachReview {
  id             String   @id @default(uuid())
  coachListingId String
  reviewerId     String
  rating         Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coachListing   CoachListing @relation(fields: [coachListingId], references: [id], onDelete: Cascade)
  reviewer       User         @relation("CoachReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([coachListingId, reviewerId])
}

// HAKEM İLANI — CoachListing'in küçültülmüş hali, bireysel/grup ayrımı yok,
// maç başı ücret var (pricePerMatch)
model RefereeListing {
  id              String   @id @default(uuid())
  userId          String
  category        String   // SPORTS / ARTS / GAMES
  subCategory     String   // tennis, padel, volleyball vb.

  credentialLevel String   // CERTIFIED | LICENSED | CLUB_REFEREE | INDEPENDENT | AMATEUR
  certName        String?
  certificateUrl  String?
  experience      Int      @default(0) // years
  achievements    String?
  achievementUrls Json     @default("[]")
  cvUrl           String?

  pricePerMatch   Int      @default(0)

  location        String
  city            String?
  days            Json     @default("[]")
  timeFrom        String   @default("09:00")
  timeTo          String   @default("21:00")

  description     String?
  status          String   @default("ACTIVE")  // ACTIVE | FLAGGED | REMOVED
  reportCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews         RefereeReview[]
}

// Hakem yorum/puanı — yalnızca o hakemin fiilen hakemlik yaptığı bir maçta
// katılımcı/sahip olanlar verebilir (ActivityRequest.refereeId üzerinden doğrulanır).
model RefereeReview {
  id               String   @id @default(uuid())
  refereeListingId String
  reviewerId       String
  rating           Int      // 1-5
  comment          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refereeListing   RefereeListing @relation(fields: [refereeListingId], references: [id], onDelete: Cascade)
  reviewer         User           @relation("RefereeReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([refereeListingId, reviewerId])
}

model EquipmentListing {
  id          String   @id @default(uuid())
  userId      String
  category    String
  subCategory String

  condition   String   // NEW | USED
  title       String
  price       Int      @default(0)
  images      Json     @default("[]")  // Cloudinary URL array
  description String?
  location    String?
  city        String?
  status      String   @default("ACTIVE")  // ACTIVE | RESERVED | SOLD | FLAGGED | REMOVED
  reportCount Int      @default(0)

  // Karşılıklı anlaşınca opsiyonlu (RESERVED) hale getirilir — belirlenen tarihe kadar
  // bu alıcı için tutulur, sonra ilan sahibi "Satıldı" ile SOLD'a geçirir.
  reservedForUserId String?
  reservedUntil     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers      EquipmentOffer[]
  messages    Message[]
}

model EquipmentOffer {
  id         String   @id @default(uuid())
  listingId  String
  fromUserId String
  price      Int
  message    String?
  status     String   @default("PENDING") // PENDING | COUNTERED | ACCEPTED | REJECTED | WITHDRAWN
  counterPrice Int?   // İlan sahibinin gönderdiği karşı teklif fiyatı (status=COUNTERED iken dolu)
  createdAt  DateTime @default(now())

  listing    EquipmentListing @relation(fields: [listingId],  references: [id], onDelete: Cascade)
  fromUser   User             @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@unique([listingId, fromUserId])
}

model UserAchievement {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  proofUrl    String?
  achievedAt  String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ListingReport {
  id          String   @id @default(uuid())
  reporterId  String
  listingType String   // EQUIPMENT | COACH
  listingId   String
  reason      String
  createdAt   DateTime @default(now())

  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, listingType, listingId])
}

// AKTİVİTE KARTI (Her kategori için ayrı kart)
model ActivityCard {
  id          String       @id @default(uuid())
  userId      String
  category    CategoryType
  cardLevel   String       @default("BRONZE")
  power       Int          @default(0)
  creativity  Int          @default(0)
  technique   Int          @default(0)
  stamina     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// GÖNDERI
model Post {
  id           String       @id @default(uuid())
  userId       String
  category     CategoryType
  subCategory  String?
  content      String
  imageUrl     String?
  videoUrl     String?
  type         String       @default("POST")  // POST | REEL | STORY
  targets      Json?                          // [{category, subCategory}, ...]
  hidden       Boolean      @default(false)   // hidden from branches, visible only on own profile
  expiresAt    DateTime?                      // set for STORY type: createdAt + 24h
  muteVideo      Boolean      @default(false)   // mute original video audio
  musicUrl       String?                        // deezer 30s preview mp3
  musicName      String?                        // track title
  musicArtist    String?                        // artist name
  musicCoverUrl  String?                        // album cover image url
  musicStartTime Float?                         // trim start in seconds
  musicEndTime   Float?                         // trim end in seconds
  location       String?                        // optional location tag
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     Comment[]
  likes        Like[]
  storyViews   StoryView[]
}

// HİKAYE GÖRÜNTÜLEMESİ
model StoryView {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// YORUM
model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// BEĞENİ
model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// MÜZİK — çalma listesi (şarkılar sıralı Json dizi, ayrı join tablosu yok — kod
// tabanındaki diğer sıralı-küçük-liste alanlarıyla (senderTeam, participants vb.) aynı desen)
model Playlist {
  id        String   @id @default(uuid())
  userId    String
  name      String
  tracks    Json     @default("[]") // [{trackId,title,artist,imageUrl,streamUrl,duration}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MÜZİK — beğenilen şarkı (dış API'den gelen track meta verisi önbelleğe alınır,
// her listelemede tekrar dış API'ye sorulmasın diye)
model LikedTrack {
  id        String   @id @default(uuid())
  userId    String
  trackId   String   // Jamendo track id (dış kaynak, FK değil)
  title     String
  artist    String
  imageUrl  String?
  streamUrl String
  duration  Int?
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

// TAKİP — istek/onay gerektirir (PENDING -> ACCEPTED | REJECTED), her yon birbirinden bagimsizdir
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// AKTİVİTE İSTEĞİ (Rakip, partner, takım arkadaşı)
model ActivityRequest {
  id              String       @id @default(uuid())
  senderId        String
  receiverId      String?
  category        CategoryType
  subCategory     String
  message         String?
  level           String?
  location        String?
  ticketUrl       String?   // Sanat kategorisi (tiyatro/müzik/sinema vb.) için gerçek bilet satış sayfası linki
  courtName       String?
  courtAddress    String?
  courtLat        Float?
  courtLng        Float?
  venueId              String?   // işletme tesisi bağlantısı
  venueCourtId         String?
  venueReservationId   String?   // hangi rezervasyondan oluşturuldu
  isCourtReserved    Boolean      @default(false)
  courtFeePerPerson  Int?
  flexibleSchedule   Boolean      @default(false)
  matchDate          DateTime?
  matchTime       String?
  levelDetail     String?
  matchType       String       @default("SINGLE") // SINGLE | DOUBLE
  teamFlexibility String       @default("FLEXIBLE") // FLEXIBLE | STRICT — Çiftler maçlarda pozisyon değiştirmeye (swap-positions) izin var mı
  matchMode       String       @default("PRACTICE") // PRACTICE | COMPETITIVE
  surface         String?                           // for volleyball: BEACH | GRASS | INDOOR
  teamSize        Int          @default(1)          // players per side (1–6 for volleyball)
  duration        Int?                              // match duration in minutes
  participants    Json         @default("[]")     // [{id, username, fullName}]
  senderTeam      Json         @default("[]")     // COMPETITIVE team: creator's additional teammates [{id,username,fullName,skillRating}]
  positions       Json         @default("[]")     // e.g. ['REFEREE'] | ['REFEREE_OFFER'] | ['GOALKEEPER']
  refereePayment  String?                         // fee offered or rate per match
  refereeRequested Boolean     @default(false)    // bu maç ilanı için hakem talep edildi mi (tenis/padel/voleybol)
  linkedRivalId   String?                         // hakem-arama ilanıysa (matchType PLAYER_WANTED, positions:['REFEREE']) bağlı olduğu asıl maç ilanının id'si
  refereeFeePerPerson Int?                        // hakemle fiyatta anlaşıldığında, hakem ücretinin oyuncu sayısına eşit bölünmüş payı (asıl maç ilanında tutulur)
  refereeId       String?                         // asıl maç ilanında: onaylanmış hakemin userId'si (hakem slotu)
  minRating       Float?                          // min skill rating to join
  maxRating       Float?                          // max skill rating to join
  status          String       @default("OPEN")   // OPEN | MATCHED | CANCELLED | COMPLETED
  score           Json?                           // {sets:[{sender:6,opponent:3},...], winner:"sender"|"opponent"}
  scoreStatus     String       @default("NONE")   // NONE | PENDING | CONFIRMED | DISPUTED
  scoreEnteredBy  String?
  scoreAppeal       Boolean  @default(false)
  scoreAppealReason String?
  completedAt     DateTime?
  archived        Boolean      @default(false)
  expiresAt            DateTime?
  mutualCancelRequests Json     @default("[]") // [userId, ...] — tracks who requested mutual cancel
  genderReq        String  @default("MIX")  // MIX | MALE | FEMALE — who can join (singles: opponent; display hint for doubles)
  partnerGenderReq String  @default("MIX")  // doubles: partner/teammate gender requirement
  opp1GenderReq    String  @default("MIX")  // doubles: opponent 1 gender requirement
  opp2GenderReq    String  @default("MIX")  // doubles: opponent 2 gender requirement
  scheduleProposal    Json?                   // {userId, date, time, location, courtName, proposedAt}
  schedulingDeadline  DateTime?               // 24h after MATCHED for flexible matches
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sender          User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User? @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  joinRequests    RivalJoinRequest[]
  matchComments   MatchComment[]
  noShowReports   NoShowReport[]
  matchPeerReviews MatchPeerReview[]
  linkedRival     ActivityRequest?  @relation("RefereeLink", fields: [linkedRivalId], references: [id], onDelete: Cascade)
  refereeAds      ActivityRequest[] @relation("RefereeLink")
  refereeUser     User?  @relation("MatchRefereeUser", fields: [refereeId], references: [id], onDelete: SetNull)
}

model MatchComment {
  id        String   @id @default(uuid())
  rivalId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  rival     ActivityRequest @relation(fields: [rivalId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NoShowReport {
  id            String   @id @default(uuid())
  rivalId       String
  reporterId    String
  absentUserIds Json     @default("[]")  // [userId, ...]
  courtPhotoUrl String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  subCategory   String
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rival         ActivityRequest @relation(fields: [rivalId],    references: [id], onDelete: Cascade)
  reporter      User            @relation("noShowReporter", fields: [reporterId], references: [id], onDelete: Cascade)
}

// AKRAN DOGRULAMA — voleybol maci sonrasi takim arkadaslari/rakipler birbirini
// puanlar (teknik+mental), skillRating'e trust-agirlikli+medyan-filtreli harman
// olarak yansitilir. AssessmentVote'tan (kart oylama) tamamen ayri, farkli amac.
model MatchPeerReview {
  id                 String   @id @default(uuid())
  matchId            String                          // ActivityRequest.id
  reviewerId         String
  revieweeId         String
  subCategory        String                          // simdilik sadece 'volleyball'
  technicalStars     Int                              // 1-5, manset/pas
  mentalStars        Int                              // 1-5, takim uyumu
  isPremade          Boolean  @default(false)         // ayni onceden-grup taraf -> harmanlamaya girmez
  trustWeightApplied Float    @default(1.0)           // oyu verenin oy ANINDAKI trustScore'u
  createdAt          DateTime @default(now())

  match     ActivityRequest @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reviewer  User @relation("PeerReviewGiven",    fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee  User @relation("PeerReviewReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([matchId, reviewerId, revieweeId])
  @@index([revieweeId, subCategory])
}

// Idempotency defteri: 0.9/0.1 harman formulu mac+kullanici basina TAM BIR KEZ
// uygulanir (tekrar calisirsa katlanir), bu tablo bunu garanti eder + denetim izi sunar.
model PeerReviewBlend {
  id                String   @id @default(uuid())
  matchId           String
  userId            String
  subCategory       String
  peerAverage       Float
  votesUsed         Int
  skillRatingBefore Float
  skillRatingAfter  Float
  appliedAt         DateTime @default(now())

  @@unique([matchId, userId])
}

model RivalJoinRequest {
  id          String   @id @default(uuid())
  rivalId     String
  userId      String
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  joiningTeam Json     @default("[]")      // COMPETITIVE team: challenger's full team [{id,username,fullName,skillRating}]
  initiatedBy     String   @default("JOINER")  // JOINER (user asked to join) | OWNER (owner invited this user)
  isPartnerInvite Boolean  @default(false)      // OWNER davet: kurucu takımına partner daveti (true) vs rakip daveti (false)
  partnerId       String?                       // Çiftler (DOUBLE): tek başına başvurmuş kullanıcının istediği partnerin userId'si. Karşılıklı olunca (iki başvuru da birbirini gösterince) çift eşleşir.
  offerPrice      String?                       // Hakem başvurusu: teklif edilen ücret
  offerMessage    String?                       // Hakem başvurusu: ek bilgi/mesaj
  offerCvUrl      String?                       // Hakem başvurusu: CV linki (varsa)
  counterPrice    String?                       // Hakem başvurusu: karşı teklif fiyatı (status=COUNTERED iken dolu)
  counterMessage  String?                       // Hakem başvurusu: karşı teklifle birlikte gönderilen mesaj
  requestedSlot   String?                       // Çiftler (DOUBLE) + teamFlexibility=STRICT: başvuru sırasında seçilen hedef taraf — 'partner' | 'opponent'
  createdAt   DateTime @default(now())

  rival      ActivityRequest @relation(fields: [rivalId],  references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@unique([rivalId, userId])
}

// ŞEHİR / İL / İLÇE
model City {
  id         String   @id @default(uuid())
  province   String
  district   String?
  status     String   @default("PENDING")  // PENDING | APPROVED
  createdAt  DateTime @default(now())

  @@unique([province, district])
}

// TURNUVA/ETKİNLİK
model Tournament {
  id             String       @id @default(uuid())
  name           String
  type           String?      @default("mix_double") // '1'..'8' (bkz. TOURN_TYPES) — anket açıksa (status=POLL) anket kapanana kadar null
  category       CategoryType
  subCategory    String
  description    String?
  scope                String       @default("YEREL")  // YEREL | ULUSAL | ULUSLARARASI
  genderType           String       @default("MIX")    // KADIN | ERKEK | MIX
  isPaid               Boolean      @default(false)
  feeType              String?      // INCLUDED (court fee in price) | SHARED (court costs split)
  playerFee            Float?       // fee per player in local currency
  paymentMethod        String?      // EFT | CASH
  ibanNumber           String?
  ibanHolder           String?
  prize1               String?
  prize2               String?
  prize3               String?
  contactPhone         String?
  minRating            Float?       // minimum skillRating to join (0.0–5.0)
  maxRating            Float?       // maximum skillRating to join (0.0–5.0)
  matchmakingType      String?      // 'ELO' | 'RANDOM' | 'SEEDED'
  matchFrequency       String?      // 'WEEKLY_1' | 'WEEKLY_2' | 'FLEXIBLE'
  matchTimeStart       String?      // earliest allowed match time e.g. '09:00'
  matchTimeEnd         String?      // latest allowed match time e.g. '22:00'
  dayTrip              Boolean      @default(false) // Günübirlik: tüm maçlar tek günde oynanır — joker/haftalık süre kuralları (3./4. madde) geçersizdir
  minPlayers           Int          @default(2)
  maxPlayers           Int          @default(32)
  setsPerMatch         Int?         // 1 | 3 | 5
  advantageScoring     Boolean?     @default(true)   // true=avantajlı, false=karar puanı, null=serbest
  matchesBeforePlayoff Int?         // play-off öncesi kaç maç
  playoffQualifiers    Int?         // play-off'a kaç kişi kalır
  location       String?
  city           String?      // il (YEREL) | ülke (ULUSAL) | Dünya (ULUSLARARASI)
  surface        String?      // clay | hard | grass | carpet | sand | artificial
  isIndoor       Boolean      @default(false)
  eventDate      DateTime?
  eventTime      String?      // tournament start time e.g. "10:00"
  eventEndDate   DateTime?    // estimated tournament end date
  eventEndTime   String?      // estimated tournament end time e.g. "18:00"
  startTime      String?      // registration start time
  endTime        String?      // registration end time
  startDate      DateTime?
  endDate        DateTime?
  pollEndDate    DateTime?    // anket bitiş tarihi (tür anketi açıksa)
  pollEndTime    String?      // anket bitiş saati, örn. "18:00"
  pollTypes      Json?        // anket açıksa, oylamaya sunulan tür ID'leri, ör. ["1","2"] — turnuvayı açan kişi seçer
  status         String       @default("OPEN")  // OPEN | IN_PROGRESS | COMPLETED | CANCELLED | POLL
  creatorId      String
  rules          Json?        @default("[]") // seçili kural ID'leri örn. [1, 2, 3]
  bracketData    Json?        // standings + phase info
  ratingSnapshot Json?        // {userId: {username, fullName, totalPoints, skillRating}}
  completedAt    DateTime?
  startedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  creator          User         @relation("tournamentCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants     TournamentParticipant[]
  typeVotes        TournamentTypeVote[]
  tournamentMatches TournamentMatch[]
  messages         TournamentMessage[]
  chatNotifyPrefs  TournamentChatNotify[]
  teams            TournamentTeam[]
  tournamentCourts TournamentCourt[]
  courtBlocks      CourtBlock[]
}

// TURNUVA GRUP SOHBETI — turnuva sahibi + AS/yedek olarak onaylanmis tum katilimcilar
model TournamentMessage {
  id           String   @id @default(uuid())
  tournamentId String
  senderId     String
  content      String
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// Turnuva sohbeti icin kisi bazli bildirim tercihi — varsayilan kapali, kullanici acarsa bildirim gider
model TournamentChatNotify {
  id           String  @id @default(uuid())
  tournamentId String
  userId       String
  enabled      Boolean @default(false)

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model TournamentMatch {
  id           String   @id @default(uuid())
  tournamentId String
  round        Int
  phase        String   @default("GROUP")   // GROUP | PLAYOFF
  matchIndex   Int      @default(0)
  p1Id         String?
  p1Name       String?
  p2Id         String?
  p2Name       String?
  score              Json?     // {sets:[{p1:X,p2:Y},...], winner:'p1'|'p2', p1Sets:N, p2Sets:N, p1Games:N, p2Games:N}
  status             String    @default("PENDING") // PENDING | COMPLETED | BYE | FORFEIT
  winnerId           String?
  deadline           DateTime?
  p1JokerRequested   Boolean   @default(false)
  p2JokerRequested   Boolean   @default(false)
  scoreEnteredBy     String?   // skoru giren kullanıcının id'si — kendi tarafı otomatik onaylanır
  p1Confirmed        Boolean   @default(false) // p1 tarafından biri (Çiftler'de takım üyesi) skoru onayladı
  p2Confirmed        Boolean   @default(false) // p2 tarafından biri skoru onayladı — ikisi de true olunca skor kilitlenir, Düzelt kalkar
  scoreSubmittedAt   DateTime? // skor en son ne zaman girildi — karşı taraf 1 saat içinde onaylamazsa otomatik onaylanır
  courtId            String?
  createdAt          DateTime  @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  court        Court?     @relation(fields: [courtId], references: [id], onDelete: SetNull)
}

// TURNUVA KATILIMCI / JOIN REQUEST
model TournamentParticipant {
  id              String   @id @default(uuid())
  tournamentId    String
  userId          String?
  manualName      String?  // set when userId is null (manual participant added by creator)
  partnerId       String?  // Çiftler Rekabetçi (type '2'): requested partner's userId. Mutual when both name each other; otherwise solo → auto-paired by ELO at tournament start.
  status          String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  note            String?
  cancelRequested Boolean   @default(false)
  cancelReason    String?
  jokerUsed       Boolean   @default(false)
  jokerUsedAt     DateTime?
  mutualJokerUsed Boolean   @default(false)  // karsilikli joker onayi - turnuva basina 1 kez
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

// TURNUVA TÜR ANKETİ — status=POLL iken kullanıcılar '1' (Bireysel) veya '2' (Çiftler) için oy verir
model TournamentTypeVote {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  votedType    String   // Tournament.pollTypes içindeki tür ID'lerinden biri, ör. '1'..'8'
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

// Çiftler Rekabetçi (Tournament.type == '2'): bir maç tarafı bir kullanıcı değil, bu takımdır.
// TournamentMatch.p1Id/p2Id bu durumda User id değil TournamentTeam id tutar.
model TournamentTeam {
  id            String   @id @default(uuid())
  tournamentId  String
  player1Id     String
  player1Name   String
  player2Id     String
  player2Name   String
  avgRating     Float    @default(0)
  createdAt     DateTime @default(now())

  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// ETKİNLİK (Konser, sergi, oyun turnuvası vb.)
model Event {
  id           String       @id @default(uuid())
  name         String
  category     CategoryType
  subCategory  String
  description  String?
  location     String?
  isOnline     Boolean      @default(false)
  maxAttendees Int?
  startDate    DateTime
  endDate      DateTime?
  status       String       @default("UPCOMING")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  participants EventParticipant[]
}

// ETKİNLİK KATILIMCI
model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}
model Court {
  id          String   @id @default(uuid())
  name        String
  address     String?
  city        String
  country     String?
  lat         Float?
  lng         Float?
  sport       String   @default("tennis")
  surface     String?
  indoor      Boolean  @default(false)
  fee         Boolean  @default(false)
  feeAmount   String?
  lights      Boolean  @default(false)
  description String?
  addedBy     String
  verified      Boolean  @default(false)
  pending       Boolean  @default(true)   // true until admin reviews
  rejectedReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  tournamentCourts TournamentCourt[]
  blocks           CourtBlock[]
  matchAssignments TournamentMatch[]
  ratings          CourtRating[]
}

model CourtRating {
  id        String   @id @default(uuid())
  courtId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)

  @@unique([userId, courtId])
}

// ARKADAŞLIK
model Friendship {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender     User @relation("friendshipSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver   User @relation("friendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

// ENGELLEME
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// KONUŞMA (DM)
model Conversation {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1     User      @relation("convUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("convUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([user1Id, user2Id])
}

// BİLDİRİM
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // JOIN_REQUEST | MATCH_CONFIRMED | MATCH_CANCELLED | FRIEND_REQUEST | MESSAGE
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?    // {rivalId, requestId, fromUserId, ...}
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MESAJ
model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  // Bir ekipman ilanı üzerinden "Sohbet Aç" ile başlatılan mesajlar, hangi ilan hakkında
  // olduğunu taşır — sohbet ekranında ilan kartı gösterilir, bildirime tıklanınca ilana gidilir.
  equipmentListingId String?
  equipmentListing   EquipmentListing? @relation(fields: [equipmentListingId], references: [id], onDelete: SetNull)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ŞEHİR UYARISI ABONELİĞİ
model CityAlert {
  id          String   @id @default(uuid())
  userId      String
  city        String
  subCategory String
  tab         String   @default("rivals")  // rivals | tournaments | coaches | equipment
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subCategory, city, tab])
}

// AKTİVİTE BİLDİRİM FİLTRESİ — kullanıcı başına tek bir kayıt; kategori/alt-kategori,
// konum (yakınlık yarıçapı ve/veya seçili şehirler) ve favori sanatçı adlarına göre
// tüm alanları boş bırakırsa o filtre "tümü" anlamına gelir (bkz. activityAlert.controller.js).
model ActivityAlert {
  id              String   @id @default(uuid())
  userId          String   @unique
  enabled         Boolean  @default(true)
  categories      String[] @default([])
  subCategories   String[] @default([])
  cities          String[] @default([])
  useProximity    Boolean  @default(false)
  radiusKm        Int?
  favoriteArtists String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// DIŞ KAYNAKLI (Ticketmaster) ETKİNLİK BİLDİRİM KAYDI — konser/tiyatro cron'unun
// aynı etkinlik için bir kullanıcıya tekrar tekrar bildirim atmasını engeller.
model NotifiedExternalEvent {
  id          String   @id @default(uuid())
  userId      String
  externalId  String   // Ticketmaster event id
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
}

// ABONELİK TALEBİ (EFT dekont onayı bekliyor)
model SubscriptionRequest {
  id          String   @id @default(uuid())
  userId      String
  packageType String   @default("STARTER")
  receiptUrl  String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// İŞLETME ABONELİĞİ
model BusinessSubscription {
  id          String   @id @default(uuid())
  userId      String
  packageType String   @default("STARTER") // STARTER | PRO | ENTERPRISE
  status      String   @default("ACTIVE")  // ACTIVE | EXPIRED | CANCELLED
  startDate   DateTime @default(now())
  endDate     DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// TURNUVA KORTU — işletme kortlarını turnuvaya bağlar
model TournamentCourt {
  id           String   @id @default(uuid())
  tournamentId String
  courtId      String
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  court        Court      @relation(fields: [courtId],      references: [id], onDelete: Cascade)

  @@unique([tournamentId, courtId])
}

// İŞLETME TESİSİ — işletme hesabı tarafından eklenir, admin onaylar
model BusinessVenue {
  id          String   @id @default(uuid())
  userId      String
  name        String
  branch      String
  city        String
  district    String?
  address     String?
  phone       String?
  openTime    String   @default("08:00")
  closeTime   String   @default("22:00")
  openSlots   Json?
  openDays    Json     @default("[1,2,3,4,5,6,7]")
  slotType              String   @default("FULL_HOUR") // FULL_HOUR | HALF_HOUR | NINETY_MIN
  pricePerSlot          Int      @default(0)           // TL cinsinden slot başı ücret
  cancelHoursBefore     Int?                           // null=her zaman, -1=asla, N>=0=N saat öncesine kadar
  rescheduleHoursBefore Int?                           // null=her zaman, -1=asla, N>=0=N saat öncesine kadar
  acceptedPayments      Json     @default("[\"CASH\",\"EFT\"]") // kabul edilen ödeme yöntemleri
  approvalMode          String   @default("FULL_AUTO")         // FULL_AUTO | EFT_TIMED | PAYMENT_AUTO | MANUAL
  courtIndoorDefault    Boolean  @default(false)            // false = açık alan, true = kapalı alan (tüm kortlar için varsayılan)
  businessIban          String?                            // EFT ödemeler için IBAN (tesis bazında)
  businessIbanHolder    String?                            // IBAN hesap sahibi adı
  pricingWindows        Json?                              // [{from,to,price,courtId?,paymentDeltas?}] saat aralığı fiyatları — paymentDeltas: {CASH,EFT,ONLINE,CREDIT_CARD} → o kuralın fiyatına eklenen sabit TL farkı (PRO+)
  contactLinks          Json?                              // {whatsapp?,telegram?,instagram?,email?,phone?}
  reservationOpenDaysBefore Int?                           // null=sınırsız (her zaman açık); 3|5|7|10|14 = rezervasyon o tarihten N gün önce açılır
  reservationOpenTime       String?                        // HH:MM, açılış saati (null=00:00)
  lat                   Float?                             // Google Maps enlem
  lng                   Float?                             // Google Maps boylam
  status       String   @default("PENDING")   // PENDING | APPROVED | REJECTED
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courts       VenueCourt[]
  reservations CourtReservation[]
  blocks       VenueBlock[]
  menuItems    VenueMenuItem[]
  orders       VenueOrder[]
  reviews      VenueReview[]
  reviewAppeals ReviewAppeal[]
}

model VenueCourt {
  id         String  @id @default(uuid())
  venueId    String
  name       String
  slotType         String?
  surface          String?
  indoor           Boolean? // null = tesis varsayılanı kullan
  lightsFrom       String?
  pricePerSlot     Int?     // null = tesis varsayılanı kullan
  maintenanceDates Json?    // [{ from: "YYYY-MM-DD", to: "YYYY-MM-DD" }]
  approvalMode     String?  // null = tesis varsayılanı kullan

  venue        BusinessVenue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservations CourtReservation[]
  reviews      VenueReview[]
}

model CourtReservation {
  id            String   @id @default(uuid())
  venueId       String
  courtId       String
  userId        String?
  manualName    String?  // userId null ise: işletmecinin telefonla girdiği müşteri adı
  date          String
  startTime     String
  endTime       String
  paymentMethod String   @default("CASH")    // EFT | CASH | ONLINE
  status        String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  noShow        Boolean  @default(false)
  receiptUrl    String?
  notes         String?
  cancelRequested     Boolean  @default(false)
  cancelRequestNote   String?
  paymentConfirmStatus String @default("PENDING") // PENDING | CONFIRMED | NOT_COLLECTED — CASH/EFT rezervasyonda saatten 30dk sonra işletmeciye sorulur
  paymentPromptSent    Boolean @default(false)    // "ödeme onayı bekleniyor" bildirimi bir kez gönderilsin diye
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  venue   BusinessVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court   VenueCourt    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId],  references: [id], onDelete: Cascade)
}

// TESİS KULLANICI ENGELİ
model VenueBlock {
  id        String   @id @default(uuid())
  venueId   String
  userId    String
  createdAt DateTime @default(now())

  venue     BusinessVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user      User          @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
}

// TESİS MENÜ KALEMİ
model VenueMenuItem {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  price     Int      @default(0)
  category  String   @default("OTHER") // EQUIPMENT | FOOD | DRINK | OTHER
  unit      String?  // ör: "/saat", "200g", "330ml"
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue      BusinessVenue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  orderItems VenueOrderItem[]
}

// TESİS SİPARİŞİ
model VenueOrder {
  id         String   @id @default(uuid())
  venueId    String
  userId     String
  status     String   @default("PENDING") // PENDING | CONFIRMED | READY | CANCELLED
  totalPrice Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  venue  BusinessVenue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId],  references: [id], onDelete: Cascade)
  items  VenueOrderItem[]
}

// SİPARİŞ KALEMİ
model VenueOrderItem {
  id         String @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int    @default(1)
  unitPrice  Int

  order    VenueOrder    @relation(fields: [orderId],    references: [id], onDelete: Cascade)
  menuItem VenueMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

// KORT BLOĞU — turnuva süresince kort rezervasyona kapalıdır
model CourtBlock {
  id           String   @id @default(uuid())
  courtId      String
  tournamentId String
  startAt      DateTime
  endAt        DateTime
  createdAt    DateTime @default(now())

  court        Court      @relation(fields: [courtId],      references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([courtId, tournamentId])
}

// TESİS / KORT YORUMU
model VenueReview {
  id        String   @id @default(uuid())
  venueId   String
  courtId   String?  // null = tesis geneli, dolu = belirli kort yorumu
  userId    String
  rating    Int      // 1–5
  comment   String?
  status    String   @default("APPROVED") // PENDING | APPROVED | REJECTED — Pro/Premium isletmelerde admin onayi gerekir, digerlerinde direkt APPROVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue   BusinessVenue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court   VenueCourt?    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId],  references: [id], onDelete: Cascade)
  appeals ReviewAppeal[]

  @@unique([userId, venueId, courtId]) // kullanıcı başına hedef başına 1 yorum
}

model ReviewAppeal {
  id         String   @id @default(uuid())
  reviewId   String
  venueId    String
  appealerId String   // venue owner userId
  reason     String
  status     String   @default("PENDING") // PENDING | RESOLVED | REJECTED
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  review   VenueReview   @relation(fields: [reviewId],   references: [id], onDelete: Cascade)
  venue    BusinessVenue @relation(fields: [venueId],    references: [id], onDelete: Cascade)
  appealer User          @relation(fields: [appealerId], references: [id], onDelete: Cascade)

  @@unique([reviewId, appealerId])
}
// ARKADAŞ BULMA — AI destekli, konum bazlı eşleştirme
model FriendFindingProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  seeking          String   @default("FRIENDS")   // FRIENDS | PARTNER | BOTH
  answers          Json                              // ham anket cevapları, gizli
  aiProfile        Json?                             // Claude'un ürettiği yapılandırılmış profil, gizli
  aiProfileVersion Int      @default(1)
  active           Boolean  @default(true)
  ageMin           Int?
  ageMax           Int?
  genderPref       Json     @default("[]")
  maxDistanceKm    Int      @default(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendFindingSwipe {
  id        String   @id @default(uuid())
  swiperId  String
  targetId  String
  decision  String   // LIKE | PASS
  createdAt DateTime @default(now())

  swiper User @relation("FFSwiper", fields: [swiperId], references: [id], onDelete: Cascade)
  target User @relation("FFTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([targetId, decision])
}

model FriendFindingMatch {
  id            String    @id @default(uuid())
  user1Id       String
  user2Id       String
  status        String    @default("ACTIVE") // ACTIVE | UNMATCHED
  matchedAt     DateTime  @default(now())
  unmatchedAt   DateTime?
  unmatchedById String?

  user1 User @relation("FFMatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FFMatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}
