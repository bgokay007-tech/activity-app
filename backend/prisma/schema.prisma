generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// KATEGORİ TÜRÜ
enum CategoryType {
  SPORTS
  SOCIAL
  ARTS
  GAMES
}

// KULLANICI
model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  phone       String?   @unique
  username    String    @unique
  password    String
  fullName    String?
  avatar      String?
  bio         String?
  birthDate   DateTime?
  country     String?
  city        String?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // İlişkiler
  interests        UserInterest[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  followers        Follow[]  @relation("following")
  following        Follow[]  @relation("follower")
  sentRequests     ActivityRequest[] @relation("sender")
  receivedRequests ActivityRequest[] @relation("receiver")
  tournaments      TournamentParticipant[]
  createdTournaments Tournament[] @relation("tournamentCreator")
  events           EventParticipant[]
  cards            ActivityCard[]
  courts           Court[]
  gender           String?  // MALE | FEMALE | OTHER
  profilePrivacy   String   @default("PUBLIC")  // PUBLIC | FRIENDS | FRIENDS_EXCEPT
  profileExclude   Json     @default("[]")        // [userId, ...]
  fullNamePrivacy  String   @default("PUBLIC")
  fullNameExclude  Json     @default("[]")
  cityPrivacy      String   @default("PUBLIC")
  genderPrivacy    String   @default("PUBLIC")
  birthDatePrivacy String   @default("PUBLIC")
  cityExclude      Json     @default("[]")
  genderExclude    Json     @default("[]")
  birthDateExclude Json     @default("[]")
  isAdmin                Boolean  @default(false)
  lateCancelCount        Int      @default(0)
  tournamentBanRemaining Int      @default(0)
  pushToken              String?
  rivalJoinReqs    RivalJoinRequest[]
  notifications    Notification[]
  sentFriendReqs   Friendship[] @relation("friendshipSender")
  receivedFriendReqs Friendship[] @relation("friendshipReceiver")
  blockedUsers     Block[] @relation("blocker")
  blockedBy        Block[] @relation("blocked")
  sentMessages     Message[]
  tournamentMessages TournamentMessage[]
  conversations1   Conversation[] @relation("convUser1")
  conversations2   Conversation[] @relation("convUser2")
  storyViews       StoryView[]
  assessmentVotesCast AssessmentVote[]
  coachListings       CoachListing[]
  equipmentListings   EquipmentListing[]
  matchComments    MatchComment[]
  noShowReports    NoShowReport[] @relation("noShowReporter")
  cityAlerts       CityAlert[]
}

model TournamentPermissionRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// KULLANICI İLGİ ALANLARI (Kategori + Alt Dal)
model UserInterest {
  id           String       @id @default(uuid())
  userId       String
  category     CategoryType
  subCategory  String       // futbol, basketbol, resim, müzik, fps, rpg vb.
  level        String       @default("BEGINNER")
  skillRating  Float        @default(0)   // 0.00 – 5.00, from assessment
  assessmentCompleted Boolean @default(false)  // anket tamamlanmadan maca katilamaz
  totalPoints  Int          @default(0)
  wins             Int          @default(0)
  losses           Int          @default(0)
  lateCancelCount  Int          @default(0)  // unilateral cancels within 5h of match
  alias        String?      // sport-specific display name shown in listings
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            Skill[]
  assessmentVotes   AssessmentVote[] @relation("VoteTarget")

  digimonVotingEnabled Boolean @default(false)

  @@unique([userId, category, subCategory])
}

// ASSESSMENT OYLAMA (digimon kart oy sistemi)
model AssessmentVote {
  id               String       @id @default(uuid())
  voterId          String
  targetInterestId String
  questionId       String
  optionIndex      Int
  createdAt        DateTime     @default(now())

  voter            User         @relation(fields: [voterId], references: [id], onDelete: Cascade)
  targetInterest   UserInterest @relation("VoteTarget", fields: [targetInterestId], references: [id], onDelete: Cascade)

  @@unique([voterId, targetInterestId, questionId])
}

// YETENEK
model Skill {
  id         String   @id @default(uuid())
  interestId String
  name       String
  value      Int      @default(0)
  createdAt  DateTime @default(now())

  interest   UserInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)
}

// ANTRENÖR İLANI
model CoachListing {
  id              String   @id @default(uuid())
  userId          String
  category        String   // SPORTS / ARTS / GAMES
  subCategory     String   // tennis, padel, etc.

  // Kimlik / Belge
  credentialLevel String   // CERTIFIED | LICENSED | CLUB_COACH | INDEPENDENT | AMATEUR
  certName        String?  // "ITF Level 2", "PTR Professional" vb.
  experience      Int      @default(0) // years

  // Ders tipleri
  individual      Boolean  @default(true)
  group           Boolean  @default(false)
  priceIndividual Int      @default(0)   // per hour, local currency
  priceGroup      Int      @default(0)   // per person per session
  maxGroupSize    Int      @default(4)

  // Yer / Zaman
  location        String
  city            String?
  days            Json     @default("[]") // ["MON","TUE",...]
  timeFrom        String   @default("09:00")
  timeTo          String   @default("21:00")

  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EquipmentListing {
  id          String   @id @default(uuid())
  userId      String
  category    String
  subCategory String

  condition   String   // NEW | USED
  title       String
  price       Int      @default(0)
  images      Json     @default("[]")  // Cloudinary URL array
  description String?
  location    String?
  city        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AKTİVİTE KARTI (Her kategori için ayrı kart)
model ActivityCard {
  id          String       @id @default(uuid())
  userId      String
  category    CategoryType
  cardLevel   String       @default("BRONZE")
  power       Int          @default(0)
  creativity  Int          @default(0)
  technique   Int          @default(0)
  stamina     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// GÖNDERI
model Post {
  id           String       @id @default(uuid())
  userId       String
  category     CategoryType
  subCategory  String?
  content      String
  imageUrl     String?
  videoUrl     String?
  type         String       @default("POST")  // POST | REEL | STORY
  targets      Json?                          // [{category, subCategory}, ...]
  hidden       Boolean      @default(false)   // hidden from branches, visible only on own profile
  expiresAt    DateTime?                      // set for STORY type: createdAt + 24h
  muteVideo      Boolean      @default(false)   // mute original video audio
  musicUrl       String?                        // deezer 30s preview mp3
  musicName      String?                        // track title
  musicArtist    String?                        // artist name
  musicCoverUrl  String?                        // album cover image url
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     Comment[]
  likes        Like[]
  storyViews   StoryView[]
}

// HİKAYE GÖRÜNTÜLEMESİ
model StoryView {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// YORUM
model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// BEĞENİ
model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// TAKİP
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// AKTİVİTE İSTEĞİ (Rakip, partner, takım arkadaşı)
model ActivityRequest {
  id              String       @id @default(uuid())
  senderId        String
  receiverId      String?
  category        CategoryType
  subCategory     String
  message         String?
  level           String?
  location        String?
  courtName       String?
  courtAddress    String?
  courtLat        Float?
  courtLng        Float?
  isCourtReserved    Boolean      @default(false)
  flexibleSchedule   Boolean      @default(false)
  matchDate          DateTime?
  matchTime       String?
  levelDetail     String?
  matchType       String       @default("SINGLE") // SINGLE | DOUBLE
  matchMode       String       @default("PRACTICE") // PRACTICE | COMPETITIVE
  surface         String?                           // for volleyball: BEACH | GRASS | INDOOR
  teamSize        Int          @default(1)          // players per side (1–6 for volleyball)
  duration        Int?                              // match duration in minutes
  participants    Json         @default("[]")     // [{id, username, fullName}]
  senderTeam      Json         @default("[]")     // COMPETITIVE team: creator's additional teammates [{id,username,fullName,skillRating}]
  positions       Json         @default("[]")     // e.g. ['REFEREE'] | ['REFEREE_OFFER'] | ['GOALKEEPER']
  refereePayment  String?                         // fee offered or rate per match
  minRating       Float?                          // min skill rating to join
  maxRating       Float?                          // max skill rating to join
  status          String       @default("OPEN")   // OPEN | MATCHED | CANCELLED | COMPLETED
  score           Json?                           // {sets:[{sender:6,opponent:3},...], winner:"sender"|"opponent"}
  scoreStatus     String       @default("NONE")   // NONE | PENDING | CONFIRMED | DISPUTED
  scoreEnteredBy  String?
  completedAt     DateTime?
  archived        Boolean      @default(false)
  expiresAt            DateTime?
  mutualCancelRequests Json     @default("[]") // [userId, ...] — tracks who requested mutual cancel
  scheduleProposal    Json?                   // {userId, date, time, location, courtName, proposedAt}
  schedulingDeadline  DateTime?               // 24h after MATCHED for flexible matches
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sender          User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User? @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  joinRequests    RivalJoinRequest[]
  matchComments   MatchComment[]
  noShowReports   NoShowReport[]
}

model MatchComment {
  id        String   @id @default(uuid())
  rivalId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  rival     ActivityRequest @relation(fields: [rivalId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NoShowReport {
  id            String   @id @default(uuid())
  rivalId       String
  reporterId    String
  absentUserIds Json     @default("[]")  // [userId, ...]
  courtPhotoUrl String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  subCategory   String
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rival         ActivityRequest @relation(fields: [rivalId],    references: [id], onDelete: Cascade)
  reporter      User            @relation("noShowReporter", fields: [reporterId], references: [id], onDelete: Cascade)
}

model RivalJoinRequest {
  id          String   @id @default(uuid())
  rivalId     String
  userId      String
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  joiningTeam Json     @default("[]")      // COMPETITIVE team: challenger's full team [{id,username,fullName,skillRating}]
  createdAt   DateTime @default(now())

  rival      ActivityRequest @relation(fields: [rivalId],  references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@unique([rivalId, userId])
}

// ŞEHİR / İL / İLÇE
model City {
  id         String   @id @default(uuid())
  province   String
  district   String?
  status     String   @default("PENDING")  // PENDING | APPROVED
  createdAt  DateTime @default(now())

  @@unique([province, district])
}

// TURNUVA/ETKİNLİK
model Tournament {
  id             String       @id @default(uuid())
  name           String
  type           String       @default("mix_double") // mix_double | singles | team
  category       CategoryType
  subCategory    String
  description    String?
  scope                String       @default("YEREL")  // YEREL | ULUSAL | ULUSLARARASI
  genderType           String       @default("MIX")    // KADIN | ERKEK | MIX
  isPaid               Boolean      @default(false)
  feeType              String?      // INCLUDED (court fee in price) | SHARED (court costs split)
  playerFee            Float?       // fee per player in local currency
  paymentMethod        String?      // EFT | CASH
  ibanNumber           String?
  ibanHolder           String?
  prize1               String?
  prize2               String?
  prize3               String?
  contactPhone         String?
  minRating            Float?       // minimum skillRating to join (0.0–5.0)
  maxRating            Float?       // maximum skillRating to join (0.0–5.0)
  matchmakingType      String?      // 'ELO' | 'RANDOM' | 'SEEDED'
  matchFrequency       String?      // 'WEEKLY_1' | 'WEEKLY_2' | 'FLEXIBLE'
  matchTimeStart       String?      // earliest allowed match time e.g. '09:00'
  matchTimeEnd         String?      // latest allowed match time e.g. '22:00'
  minPlayers           Int          @default(2)
  maxPlayers           Int          @default(32)
  setsPerMatch         Int?         // 1 | 3 | 5
  advantageScoring     Boolean?     @default(true)   // true=avantajlı, false=karar puanı, null=serbest
  matchesBeforePlayoff Int?         // play-off öncesi kaç maç
  playoffQualifiers    Int?         // play-off'a kaç kişi kalır
  location       String?
  city           String?      // il (YEREL) | ülke (ULUSAL) | Dünya (ULUSLARARASI)
  surface        String?      // clay | hard | grass | carpet | sand | artificial
  isIndoor       Boolean      @default(false)
  eventDate      DateTime?
  eventTime      String?      // tournament start time e.g. "10:00"
  eventEndDate   DateTime?    // estimated tournament end date
  eventEndTime   String?      // estimated tournament end time e.g. "18:00"
  startTime      String?      // registration start time
  endTime        String?      // registration end time
  startDate      DateTime?
  endDate        DateTime?
  status         String       @default("OPEN")  // OPEN | IN_PROGRESS | COMPLETED | CANCELLED
  creatorId      String
  rules          Json?        @default("[]") // seçili kural ID'leri örn. [1, 2, 3]
  bracketData    Json?        // standings + phase info
  ratingSnapshot Json?        // {userId: {username, fullName, totalPoints, skillRating}}
  completedAt    DateTime?
  startedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  creator          User         @relation("tournamentCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants     TournamentParticipant[]
  tournamentMatches TournamentMatch[]
  messages         TournamentMessage[]
}

// TURNUVA GRUP SOHBETI — turnuva sahibi + AS/yedek olarak onaylanmis tum katilimcilar
model TournamentMessage {
  id           String   @id @default(uuid())
  tournamentId String
  senderId     String
  content      String
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model TournamentMatch {
  id           String   @id @default(uuid())
  tournamentId String
  round        Int
  phase        String   @default("GROUP")   // GROUP | PLAYOFF
  matchIndex   Int      @default(0)
  p1Id         String?
  p1Name       String?
  p2Id         String?
  p2Name       String?
  score              Json?     // {sets:[{p1:X,p2:Y},...], winner:'p1'|'p2', p1Sets:N, p2Sets:N, p1Games:N, p2Games:N}
  status             String    @default("PENDING") // PENDING | COMPLETED | BYE | FORFEIT
  winnerId           String?
  deadline           DateTime?
  p1JokerRequested   Boolean   @default(false)
  p2JokerRequested   Boolean   @default(false)
  createdAt          DateTime  @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// TURNUVA KATILIMCI / JOIN REQUEST
model TournamentParticipant {
  id              String   @id @default(uuid())
  tournamentId    String
  userId          String?
  manualName      String?  // set when userId is null (manual participant added by creator)
  status          String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  note            String?
  cancelRequested Boolean   @default(false)
  cancelReason    String?
  jokerUsed       Boolean   @default(false)
  jokerUsedAt     DateTime?
  mutualJokerUsed Boolean   @default(false)  // karsilikli joker onayi - turnuva basina 1 kez
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

// ETKİNLİK (Konser, sergi, oyun turnuvası vb.)
model Event {
  id           String       @id @default(uuid())
  name         String
  category     CategoryType
  subCategory  String
  description  String?
  location     String?
  isOnline     Boolean      @default(false)
  maxAttendees Int?
  startDate    DateTime
  endDate      DateTime?
  status       String       @default("UPCOMING")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  participants EventParticipant[]
}

// ETKİNLİK KATILIMCI
model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}
model Court {
  id          String   @id @default(uuid())
  name        String
  address     String?
  city        String
  country     String?
  lat         Float?
  lng         Float?
  sport       String   @default("tennis")
  surface     String?
  indoor      Boolean  @default(false)
  fee         Boolean  @default(false)
  feeAmount   String?
  lights      Boolean  @default(false)
  description String?
  addedBy     String
  verified      Boolean  @default(false)
  pending       Boolean  @default(true)   // true until admin reviews
  rejectedReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [addedBy], references: [id], onDelete: Cascade)
}

// ARKADAŞLIK
model Friendship {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender     User @relation("friendshipSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver   User @relation("friendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

// ENGELLEME
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// KONUŞMA (DM)
model Conversation {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1     User      @relation("convUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("convUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([user1Id, user2Id])
}

// BİLDİRİM
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // JOIN_REQUEST | MATCH_CONFIRMED | MATCH_CANCELLED | FRIEND_REQUEST | MESSAGE
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?    // {rivalId, requestId, fromUserId, ...}
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MESAJ
model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ŞEHİR UYARISI ABONELİĞİ
model CityAlert {
  id          String   @id @default(uuid())
  userId      String
  city        String
  subCategory String
  tab         String   @default("rivals")  // rivals | tournaments | coaches | equipment
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subCategory, city, tab])
}