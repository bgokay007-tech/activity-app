generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// KATEGORİ TÜRÜ
enum CategoryType {
  SPORTS
  SOCIAL
  ARTS
  GAMES
}

// KULLANICI
model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  phone       String?   @unique
  username    String    @unique
  password    String
  fullName    String?
  avatar      String?
  bio         String?
  birthDate   DateTime?
  country     String?
  city        String?
  isPublic    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // İlişkiler
  interests        UserInterest[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  commentLikes     CommentLike[]
  playlists        Playlist[]
  likedTracks      LikedTrack[]
  followers        Follow[]  @relation("following")
  following        Follow[]  @relation("follower")
  sentRequests     ActivityRequest[] @relation("sender")
  receivedRequests ActivityRequest[] @relation("receiver")
  tournaments      TournamentParticipant[]
  tournamentTypeVotes TournamentTypeVote[]
  createdTournaments Tournament[] @relation("tournamentCreator")
  events           EventParticipant[]
  cards            ActivityCard[]
  courts           Court[]
  gender           String?  // MALE | FEMALE | OTHER
  // Gizlilik modlari: PUBLIC | FRIENDS | FOLLOWERS | FRIENDS_EXCEPT | FRIENDS_SELECTED
  // *Exclude alani moda gore yeniden yorumlanir: FRIENDS_EXCEPT -> haric tutulanlar, FRIENDS_SELECTED -> sadece dahil edilenler
  profilePrivacy   String   @default("PUBLIC")
  profileExclude   Json     @default("[]")        // [userId, ...]
  fullNamePrivacy  String   @default("PUBLIC")
  fullNameExclude  Json     @default("[]")
  cityPrivacy      String   @default("PUBLIC")
  genderPrivacy    String   @default("PUBLIC")
  birthDatePrivacy String   @default("PUBLIC")
  cityExclude      Json     @default("[]")
  genderExclude    Json     @default("[]")
  birthDateExclude Json     @default("[]")
  postsPrivacy        String @default("PUBLIC")
  postsExclude        Json   @default("[]")
  reelsPrivacy        String @default("PUBLIC")
  reelsExclude        Json   @default("[]")
  friendsListPrivacy  String @default("PUBLIC")
  friendsListExclude  Json   @default("[]")
  activitiesPrivacy   String @default("PUBLIC")
  activitiesExclude   Json   @default("[]")
  likesCommentsPrivacy String @default("PUBLIC")
  likesCommentsExclude Json   @default("[]")
  isAdmin                Boolean  @default(false)
  isBusiness             Boolean  @default(false)
  isDemoUser             Boolean  @default(false)  // test/demo botu — gerçek kullanıcı değil (bkz. demo.controller.js, jobs/demoBotResponder.js)
  demoAutoReject         Boolean  @default(false)  // bu demo bot davet/başvuruları hep reddeder (test için "hep hayır diyen" sabit oyuncular)
  businessName           String?
  taxNumber              String?
  businessAddress        String?
  lateCancelCount        Int      @default(0)
  tournamentBanRemaining Int      @default(0)
  // Pro/Premium işletmelerin REDDETTİĞİ politika-dışı iptal/değişiklik talebi sayısı (kalıcı,
  // tüm Pro/Premium tesisler toplamı) — 5'i geçince Pro/Premium tesislerde yeni rezervasyon/ilan
  // oluşturma engellenir (bkz. venue.controller.js assertNotVenuePolicyBlocked).
  venuePolicyRejectionCount Int   @default(0)
  pushToken              String?
  // Uygulamanın merkezi bildirim kontrolü — Bildirimler ekranındaki "Sessize Al" butonundan
  // seçilir. MUTE: push sessiz+titreşimsiz düşer, VIBRATE: sadece titreşim, SOUND: normal ses.
  // Belirli bir dal/kategori için bildirim açık olsa bile (CityAlert vb.) telefona bu moda göre düşer.
  notificationMode       String   @default("SOUND")
  rivalJoinReqs    RivalJoinRequest[]
  notifications    Notification[]
  sentFriendReqs   Friendship[] @relation("friendshipSender")
  receivedFriendReqs Friendship[] @relation("friendshipReceiver")
  blockedUsers     Block[] @relation("blocker")
  blockedBy        Block[] @relation("blocked")
  messageBlockedUsers MessageBlock[] @relation("msgBlocker")
  messageBlockedBy    MessageBlock[] @relation("msgBlocked")
  sentMessages     Message[]
  tournamentMessages TournamentMessage[]
  tournamentChatNotifyPrefs TournamentChatNotify[]
  conversations1   Conversation[] @relation("convUser1")
  conversations2   Conversation[] @relation("convUser2")
  conversationMutes ConversationMute[]
  messageDeletions MessageDeletion[]
  storyViews       StoryView[]
  assessmentVotesCast AssessmentVote[]
  ratingMatchRecords RatingMatchRecord[]
  coachListings       CoachListing[]
  artistListing       ArtistListing?
  refereeListings     RefereeListing[]
  refereedMatches     ActivityRequest[] @relation("MatchRefereeUser")
  coachLessonRequests CoachLessonRequest[] @relation("CoachLessonStudent")
  coachReviewsGiven   CoachReview[] @relation("CoachReviewer")
  refereeReviewsGiven RefereeReview[] @relation("RefereeReviewer")
  refereeReviewsReceived RefereeReview[] @relation("RefereeReviewReceived")
  equipmentListings   EquipmentListing[]
  equipmentPurchases  EquipmentListing[] @relation("EquipmentSoldTo")
  equipmentOffers     EquipmentOffer[]
  listingReports      ListingReport[]
  userAchievements    UserAchievement[]
  matchComments    MatchComment[]
  noShowReports    NoShowReport[] @relation("noShowReporter")
  peerReviewsGiven    MatchPeerReview[] @relation("PeerReviewGiven")
  peerReviewsReceived MatchPeerReview[] @relation("PeerReviewReceived")
  cityAlerts       CityAlert[]
  activityAlert    ActivityAlert?
  notifiedExternalEvents NotifiedExternalEvent[]
  surveyGiven      SportSurvey[] @relation("SurveyRater")
  surveyReceived   SportSurvey[] @relation("SurveySubject")
  volleyballRatingsGiven    VolleyballRating[] @relation("VolleyballRatingRater")
  volleyballRatingsReceived VolleyballRating[] @relation("VolleyballRatingSubject")
  padelRatingsGiven    PadelRating[] @relation("PadelRatingRater")
  padelRatingsReceived PadelRating[] @relation("PadelRatingSubject")
  matchSpectations     MatchSpectator[]
  profileChangeRequests ProfileChangeRequest[]
  supportMessages       SupportMessage[]
  subscriptions         BusinessSubscription[]
  subscriptionRequests  SubscriptionRequest[]
  teamNameRequests      TeamNameRequest[]
  businessIban          String?
  businessIbanHolder    String?
  venues                BusinessVenue[]
  contactPhone       String?
  contactTelegram    String?
  contactEmail       String?
  contactInstagram   String?
  phonePrivacy       String  @default("FRIENDS")
  phoneSelected      Json    @default("[]")
  telegramPrivacy    String  @default("FRIENDS")
  telegramSelected   Json    @default("[]")
  cEmailPrivacy      String  @default("FRIENDS")
  cEmailSelected     Json    @default("[]")
  instagramPrivacy   String  @default("PUBLIC")
  instagramSelected  Json    @default("[]")
  courtReservations     CourtReservation[]
  venueLoyaltyCredits   VenueLoyaltyCredit[]
  venueBlocks           VenueBlock[]       @relation("BlockedUser")
  venueOrders           VenueOrder[]
  venueBillItems        VenueBillItem[]
  venueReviews          VenueReview[]
  courtRatings          CourtRating[]
  reviewAppeals         ReviewAppeal[]
  trails                Trail[]         @relation("TrailCreator")
  trailReviews          TrailReview[]   @relation("TrailReviewUser")
  trailComments         TrailComment[]  @relation("TrailCommentUser")

  // Arkadaş Bulma (konum bazlı eşleştirme)
  lat                  Float?
  lng                  Float?
  locationUpdatedAt    DateTime?
  locationPrivacy      String    @default("FRIENDS")
  locationExclude      Json      @default("[]")
  friendFindingProfile FriendFindingProfile?
  ffSwipesGiven        FriendFindingSwipe[] @relation("FFSwiper")
  ffSwipesReceived     FriendFindingSwipe[] @relation("FFTarget")
  ffMatchesAsUser1     FriendFindingMatch[] @relation("FFMatchUser1")
  ffMatchesAsUser2     FriendFindingMatch[] @relation("FFMatchUser2")

  @@index([lat, lng])
}

model ProfileChangeRequest {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field        String   // 'fullName' | 'gender' | 'birthDate'
  currentValue String?
  newValue     String?
  documentUrl  String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// KULLANICIDAN ADMİNE DESTEK MESAJI
model SupportMessage {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  status     String   @default("PENDING") // PENDING | ANSWERED
  adminReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SportSurvey {
  id          String   @id @default(cuid())
  subjectId   String
  raterId     String
  subCategory String
  stres       Int
  fairplay    Int
  beden       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subject     User     @relation("SurveySubject", fields: [subjectId], references: [id], onDelete: Cascade)
  rater       User     @relation("SurveyRater",   fields: [raterId],   references: [id], onDelete: Cascade)
  @@unique([subjectId, raterId, subCategory])
}

// Voleybol oyuncu değerlendirme anketi — kendi/onaylı antrenör/takım arkadaşı olmak üzere
// üç ayrı kaynaktan doldurulur, %40/%50/%10 ile harmanlanıp derece puanına dönüşür
// (bkz. backend/src/utils/volleyballRating.js). UserInterest.skillRating'e (ELO) DOKUNMAZ,
// tamamen izole bir puanlama.
model VolleyballRating {
  id                String   @id @default(uuid())
  subjectId         String
  raterId           String
  raterRole         String   // SELF | COACH | TEAMMATE — sunucu belirler, client'tan gelmez
  serve             Int      // Servis
  receptionPass     Int      // Manşet ve Pas
  spike             Int      // Smaç ve Hücum
  block             Int      // Blok
  serveReception    Int      // Manşet Karşılama (Servis Karşılama)
  endurance         Int      // Dayanıklılık
  agility           Int      // Çeviklik ve Hız
  jump              Int      // Sıçrama Yeteneği
  gameVision        Int      // Oyun Görüşü
  teamCommunication Int      // Takım Uyumu ve İletişim
  decisionMaking    Int      // Baskı Altında Karar Verme

  // 4. Genel Değerlendirme — sadece raterRole COACH/TEAMMATE iken doldurulur (SELF'te null
  // kalır). Derece puanına hiç katılmaz, salt yorum olarak saklanır.
  strongestPoint         String?
  weakestPoint           String?
  generalPerformanceNote Int?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subject User @relation("VolleyballRatingSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  rater   User @relation("VolleyballRatingRater",   fields: [raterId],   references: [id], onDelete: Cascade)

  @@unique([subjectId, raterId])
  @@index([subjectId])
}

// Padel oyuncu değerlendirme anketi — VolleyballRating ile birebir aynı mimari (kendi/onaylı
// antrenör/takım arkadaşı olmak üzere üç ayrı kaynaktan doldurulur, %85/%10/%5 ile harmanlanıp
// UserInterest.skillRating'e yazılır — bkz. backend/src/utils/padelRating.js). Voleyboldan
// farklı olarak burada harmanlanmış puan GERÇEK skillRating'i günceller (izole değil).
model PadelRating {
  id                String   @id @default(uuid())
  subjectId         String
  raterId           String
  raterRole         String   // SELF | COACH | TEAMMATE — sunucu belirler, client'tan gelmez
  forehandDrive     Int      // Forehand Vuruşu
  backhandDrive     Int      // Backhand Vuruşu
  volley            Int      // Vole (File Önü) Vuruşları
  smash             Int      // Bandeja / Smaç
  agility           Int      // Çeviklik ve Hareket Kabiliyeti
  endurance         Int      // Dayanıklılık
  reflexes          Int      // Refleks
  courtPositioning  Int      // Kort Pozisyon Alma
  shotSelection     Int      // Doğru Vuruş Seçimi
  teamCommunication Int      // Çift Oyun Uyumu ve İletişim

  // Genel Değerlendirme — sadece raterRole COACH/TEAMMATE iken doldurulur (SELF'te null kalır).
  // Derece puanına hiç katılmaz, salt yorum olarak saklanır.
  strongestPoint         String?
  weakestPoint           String?
  generalPerformanceNote Int?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subject User @relation("PadelRatingSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  rater   User @relation("PadelRatingRater",   fields: [raterId],   references: [id], onDelete: Cascade)

  @@unique([subjectId, raterId])
  @@index([subjectId])
}

model TournamentPermissionRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// KULLANICI İLGİ ALANLARI (Kategori + Alt Dal)
model UserInterest {
  id           String       @id @default(uuid())
  userId       String
  category     CategoryType
  subCategory  String       // futbol, basketbol, resim, müzik, fps, rpg vb.
  level        String       @default("BEGINNER")
  skillRating  Float        @default(0)   // 0.00 – 5.00, from assessment
  selfAssessmentRating Float?  // padel: sadece kendi anketinden gelen ham puan — coach/teammate
                                // değerlendirmesiyle harmanlanan skillRating'den AYRI tutulur, aksi
                                // halde her yeni değerlendirmede üst üste binerdi (bkz. applyBlendedPadelRating)
  assessmentCompleted Boolean @default(false)  // anket tamamlanmadan maca katilamaz
  matchesSinceAssessment Int @default(0)  // tenis/padel: anketten sonra oynanan maç sayısı (0-3, ilk 3 maç doğrulama penceresi)
  totalPoints  Int          @default(0)
  walletPoints Int          @default(2000)  // okey/batak gibi bahisli oyunlar icin harcanabilir puan bakiyesi
  wins             Int          @default(0)
  losses           Int          @default(0)
  lateCancelCount  Int          @default(0)  // unilateral cancels within 5h of match
  alias        String?      // sport-specific display name shown in listings
  goals        String?      // kullanicinin bu bransa ozel kendine yazdigi hedef/soz metni (serbest metin, dal bagimsiz ortak "Hedefler" ekrani yerine)
  hidden       Boolean      @default(false)  // 3+ maci olan branslar silinemez, sadece gizlenir (puan/gecmis korunur)
  trustScore   Float        @default(1.0)  // 0.2-1.0, akran oyu verirken guvenilirlik (bkz. MatchPeerReview)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // UTR-esinli tenis/padel puanlama (bkz. backend/src/utils/utrRating.js) — SADECE tennis/padel
  // subCategory'lerinde kullanılır, diğer dallarda hep null/0 kalır. skillRating bu iki dal için
  // artık otoriter değil (getDisplayRating() üzerinden okunur), geriye dönük uyumluluk için duruyor.
  singlesRating          Float?     // tekli — son ≤30 maçlık kayan pencerenin ağırlıklı ortalaması
  doublesRating          Float?     // çiftler — ayrı kayan pencere
  singlesSeedRating      Float?     // ankettten gelen başlangıç puanı — recompute'ta her zaman referans (bkz. §3 seedWeight)
  doublesSeedRating      Float?
  singlesRatingOffset    Float      @default(0)  // ceza (no-show/geç iptal) — recompute'ın üzerine BİNER, ezilmez
  doublesRatingOffset    Float      @default(0)
  singlesMatchCount      Int        @default(0)
  doublesMatchCount      Int        @default(0)
  singlesLastMatchAt     DateTime?
  doublesLastMatchAt     DateTime?
  assessmentCompletedAt  DateTime?  // tenis/padel reassessment-grace penceresinin dayanak noktası

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            Skill[]
  assessmentVotes   AssessmentVote[] @relation("VoteTarget")

  digimonVotingEnabled Boolean @default(false)

  @@unique([userId, category, subCategory])
}

// UTR-esinli tenis/padel puanlama: her nitelikli maç için tek bir ham kayıt. Kayan pencere
// (≤30 maç / 12 ay) recompute anında bu tablodan taze hesaplanır — zaman aşımı ağırlığı
// SAKLANMAZ, çünkü "şimdi"ye bağlıdır (bkz. backend/src/utils/utrRating.js recomputeRatingFromHistory).
model RatingMatchRecord {
  id                          String   @id @default(uuid())
  userId                      String
  subCategory                 String   // 'tennis' | 'padel'
  matchType                   String   // 'SINGLE' | 'DOUBLE'
  sourceType                  String   // 'RIVAL' | 'TOURNAMENT'
  sourceId                    String   // ActivityRequest.id veya TournamentMatch.id (denetim/debug)
  matchDate                   DateTime
  didWin                      Boolean
  performanceScore            Float    // 0-1, oynanan setlerdeki kazanılan oyun oranı
  opponentRatingSnapshot      Float    // rakip tarafın maç anındaki aynı-disiplin ratingi
  opponentReliabilitySnapshot Float    // 0-1, maç anında donmuş (sonradan değişmez)
  formatWeight                Float    // 0-1, set sayısından tahmin
  ratingBefore                Float
  ratingAfter                 Float
  createdAt                   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subCategory, matchType, matchDate])
}

// ASSESSMENT OYLAMA (digimon kart oy sistemi)
model AssessmentVote {
  id               String       @id @default(uuid())
  voterId          String
  targetInterestId String
  questionId       String
  optionIndex      Int
  createdAt        DateTime     @default(now())

  voter            User         @relation(fields: [voterId], references: [id], onDelete: Cascade)
  targetInterest   UserInterest @relation("VoteTarget", fields: [targetInterestId], references: [id], onDelete: Cascade)

  @@unique([voterId, targetInterestId, questionId])
}

// YETENEK
model Skill {
  id         String   @id @default(uuid())
  interestId String
  name       String
  value      Int      @default(0)
  createdAt  DateTime @default(now())

  interest   UserInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)
}

// ANTRENÖR İLANI
model CoachListing {
  id              String   @id @default(uuid())
  userId          String
  category        String   // SPORTS / ARTS / GAMES
  subCategory     String   // tennis, padel, etc.

  // Kimlik / Belge
  credentialLevel String   // CERTIFIED | LICENSED | CLUB_COACH | INDEPENDENT | AMATEUR
  certName        String?  // "ITF Level 2", "PTR Professional" vb.
  certificateUrl  String?  // yuklenen belge/sertifika dosyasi (pdf veya foto) — geriye donuk uyumluluk icin duruyor, yeni kayitlarda certificateUrls[0] ile ayni tutulur
  certificateUrls Json     @default("[]") // birden fazla belge/sertifika fotografi
  experience      Int      @default(0) // years
  achievements    Json?    // basarilar - string[] (kullanici "Ekle" ile birden fazla girebilir; eskiden tek String'di, migration'da [text] olarak tasindi)
  achievementUrls Json     @default("[]") // basari belgesi/foto dosyalari
  cvUrl           String?  // yuklenen CV dosyasi
  // Kullanici istegi: CV Yukle ekrani ders tipi/ucret/sehir istemeden sadece kimlik/belge/CV
  // kaydedebiliyor — boyle bir "kabuk" kayit gercek bir ders teklifi olmadigi icin baskalarina
  // hic gorunmemeli, sadece sahibi kendi CV'sini gormek icin gorur (bkz. getListings).
  profileOnly     Boolean  @default(false)
  // Kullanici istegi: antrenorluk ilani kullanici adiyla degil bu kisisel bilgilerle
  // gorunsun — genel hesap profilinden bagimsiz, ozellikle bu CV icin girilir.
  personalFullName  String?
  personalGender    String?  // MALE | FEMALE | OTHER
  // Kullanici istegi: sadece yil degil gun/ay/yil olarak girilebilsin (eskiden personalBirthYear
  // Int'ti, migration'da o yilin 1 Ocak'i olarak tasindi).
  personalBirthDate DateTime?
  // Kullanici istegi: "Ekle" dedikce calisilan yer/pozisyon/tarih araligi icin yeni bir satir
  // acilsin — [{workplace, position, period}, ...] (eskiden serbest metindi, migration'da
  // tek elemanli bir diziye tasindi).
  priorExperience   Json?

  // Kullanici istegi: resmi/dogrulama bilgileri — TTF/GSB onayli belge, kademe, T.C. kimlik ve
  // adli sicil dogrulamasi. tcKimlikNo/adliSicilUrl SADECE sahibi ve admin gorur (bkz.
  // coach.controller.js redactSensitiveCoachFields), digerlerine hic donulmez. Bunlardan biri
  // degisirse (updateListing) onaylanmis bir ilanin onayi otomatik dusuyor — cvUrl ile ayni desen.
  certIssuer        String?  // TTF | GSB | OTHER — belgeyi veren resmi kurum
  kademe            String?  // "1. Kademe Yardimci Antrenor", "2. Kademe Antrenor" vb.
  tcKimlikNo        String?
  tcKimlikVerified  Boolean  @default(false)
  adliSicilUrl      String?  // e-Devlet temiz adli sicil belgesi (foto/PDF)
  adliSicilVerified Boolean  @default(false)
  education         String?  // Spor Bilimleri Fakultesi / BESYO vb.
  specializations   Json?    // string[] — cocuk_tenisi | yetiskin_tenisi | performans | hobi | kardiyo

  // Sosyal kanit — kullanici istegi: profil fotografi (hesap avatarindan bagimsiz), tanitim
  // videosu, sosyal medya linkleri.
  profilePhotoUrl   String?
  introVideoUrl     String?
  socialInstagram   String?
  socialLinkedin    String?

  // Ders tipleri
  individual      Boolean  @default(true)
  group           Boolean  @default(false)
  priceIndividual Int      @default(0)   // per hour, local currency
  priceGroup      Int      @default(0)   // per person per session
  maxGroupSize    Int      @default(4)
  includedEquipment String? // Kullanici istegi: fiyata dahil olan ekipmanlar (orn. Raket, Top)
  // Kullanici istegi: "en cok yasanan anlasmazlik konusu" — ders fiyatina kort kirasinin
  // dahil olup olmadigi acikca belirtilsin. null = belirtilmemis.
  courtFeeIncluded  Boolean?

  // Yer / Zaman
  location        String?  // kort/tesis adı — artık zorunlu değil, birden fazla şehirde ders
  // veren antrenörler için tek bir sabit mekan anlamlı olmayabiliyor (bkz. cities)
  city            String?  // eski tekil alan — geriye dönük uyumluluk için duruyor, yeni
  // kayıtlarda kullanılmıyor, bkz. cities
  cities          Json?    // string[] — kullanıcı isteği: konum yerine bir/birden fazla şehir
  // zorunlu (voleybol/tenis/padelde antrenörlük başvurusu artık şehir(ler) ister)
  days            Json     @default("[]") // ["MON","TUE",...]
  timeFrom        String   @default("09:00")
  timeTo          String   @default("21:00")

  description     String?
  status          String   @default("ACTIVE")  // ACTIVE | FLAGGED | REMOVED | REJECTED (admin basvuruyu reddetti, bkz. setCoachListingApproval)
  reportCount     Int      @default(0)
  approvedForRating Boolean @default(false)  // admin onayı — voleybolde resmi oyuncu değerlendirmesi verebilir (bkz. VolleyballRating)
  // approvedForRating'den AYRI bir onay — bu ilanın KENDİSİNİN başkalarına görünüp
  // rezervasyon alabilmesi için (RefereeListing.approved ile aynı desen). Sadece voleybolde
  // zorunlu; diğer dallarda kontrol edilmediği için yayınlanır yayınlanmaz görünür kalır.
  approved        Boolean @default(false)
  adminNote       String?  // kullanıcı isteği: admin başvuruyu reddederken bir açıklama
  // yazabilsin, kullanıcıya bu sebeple bildirim gitsin (bkz. setCoachListingApproval REJECT)

  // Kullanıcı isteği: admin onayı SÜRESİZ değil, en son onaylandığı tarihten itibaren 1 yıl
  // geçerli — süre dolunca approvalExpiryJob otomatik approved:false yapar ama approvedAt'i
  // SİLMEZ (geçmiş onay kaydı olarak kalır), böylece admin panelinde bu bir "yenileme
  // başvurusu" olarak görünür (bkz. getCoachListingApprovals). Yeniden onaylanınca üzerine yazılır.
  approvedAt          DateTime?
  // Kullanıcı isteği: admin onaylarken "şu bilgiler eksik/yanlış, X gün içinde düzeltilmezse
  // onay iptal edilir" diyebilsin — koşullu onay. conditionalDeadline dolana kadar onaylı
  // kalır, kullanıcı ilanını güncellerse (updateListing) düzeltme girişimi sayılıp temizlenir,
  // yoksa approvalExpiryJob otomatik approved:false yapar.
  conditionalNote     String?
  conditionalDeadline DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonRequests  CoachLessonRequest[]
  reviews         CoachReview[]
  messages        Message[]
}

// Öğrencinin antrenörle "ders aldım" ilişkisini kurması — antrenör kabul edince
// öğrenci o antrenöre yorum/yıldız verebilir hale gelir (bkz. CoachReview).
model CoachLessonRequest {
  id             String   @id @default(uuid())
  coachListingId String
  studentId      String
  status         String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  message        String?
  createdAt      DateTime @default(now())

  coachListing   CoachListing @relation(fields: [coachListingId], references: [id], onDelete: Cascade)
  student        User         @relation("CoachLessonStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([coachListingId, studentId])
}

model CoachReview {
  id             String   @id @default(uuid())
  coachListingId String
  reviewerId     String
  rating         Int      // 1-5
  comment        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coachListing   CoachListing @relation(fields: [coachListingId], references: [id], onDelete: Cascade)
  reviewer       User         @relation("CoachReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([coachListingId, reviewerId])
}

// SANATÇI İLANI — müzik dalı altındaki "Sanatçılar" sekmesi: sanatçılar kendi
// etkinlik/performans/yeteneklerini tanıtır, etkinlik sahipleri (ör. maç/turnuva
// ilanına "hizmet" olarak DJ/sanatçı eklerken) buradan seçip iletişime geçer.
// Kullanıcı başına tek aktif profil (upsert mantığıyla oluşturulur/güncellenir).
model ArtistListing {
  id            String   @id @default(uuid())
  userId        String   @unique
  artistType    String   // DJ | BAND | SOLO_MUSICIAN | DANCER | OTHER
  stageName     String?  // sahne adı — boşsa kullanıcı adı gösterilir
  genres        String?  // "Pop, Rock, Elektronik" gibi serbest metin
  description   String?
  pricePerEvent Int?     // etkinlik başı ücret — boşsa "iletişime geç"
  portfolioUrl1 String?  // Instagram/YouTube/portfolyo linki
  portfolioUrl2 String?
  city          String?
  status        String   @default("ACTIVE") // ACTIVE | REMOVED
  reportCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// HAKEM İLANI — CoachListing'in küçültülmüş hali, bireysel/grup ayrımı yok,
// maç başı ücret var (pricePerMatch)
model RefereeListing {
  id              String   @id @default(uuid())
  userId          String
  category        String   // SPORTS / ARTS / GAMES
  subCategory     String   // tennis, padel, volleyball vb.

  credentialLevel String   // CERTIFIED | LICENSED | CLUB_REFEREE | INDEPENDENT | AMATEUR
  certName        String?
  certificateUrl  String?  // geriye donuk uyumluluk icin duruyor, bkz. CoachListing.certificateUrl
  certificateUrls Json     @default("[]")
  experience      Int      @default(0) // years
  achievements    Json?    // basarilar - string[] (bkz. CoachListing.achievements ile ayni desen)
  achievementUrls Json     @default("[]")
  cvUrl           String?
  profileOnly     Boolean  @default(false) // bkz. CoachListing.profileOnly ile ayni desen

  // Kullanıcı isteği: hakemlik CV'sinde de antrenörlükteki gibi kişisel bilgiler toplanıyor —
  // normalde zorunlu değil, ama "Amatör" kademe seçilirse SADECE bunlar zorunlu oluyor, diğer
  // tüm belge/doğrulama zorunlulukları kalkıyor (bkz. createListing, CoachListing ile aynı desen).
  personalFullName  String?
  personalGender    String?  // MALE | FEMALE | OTHER
  personalBirthDate DateTime?

  pricePerMatch   Int      @default(0)

  // Kullanıcı isteği: tenis hakemliğinde admin onayından önce mutlaka kontrol edilmesi
  // gereken resmi lisans/kademe/doğrulama bilgileri (TTF i-KORT sistemiyle uyumlu alanlar).
  // Sadece tenis dalında zorunlu (bkz. createListing), diğer dallarda kullanılmıyor.
  // adliSicilUrl/cezaBelgesiUrl SADECE sahibi ve admin görür (bkz. redactSensitiveRefereeFields,
  // CoachListing.adliSicilUrl ile aynı desen).
  ikortNo         String?  // TTF Hakem Sicil Numarası (i-KORT ID)
  refereeKademe   String?  // ADAY | IL | ULUSAL | ULUSLARARASI
  vizeBelgesiUrl  String?  // güncel vize durumunu gösteren i-KORT profil ekran görüntüsü/belge
  itfBadgeLevel   String?  // WHITE | BRONZE | SILVER | GOLD — opsiyonel, sadece ITF rozetli hakemler için
  itfCertNo       String?  // ITF sertifika numarası — opsiyonel
  adliSicilUrl    String?  // e-Devlet adli sicil belgesi (foto/PDF)
  cezaBelgesiUrl  String?  // TTF/Spor Bilgi Sistemi'nden alınan disiplin cezası almadığına dair belge
  ilTemsilciligi  String?  // bağlı olduğu il temsilciliği
  specialization  Json?    // string[] — tenis: kule_hakemi/cizgi_hakemi, voleybol: bashakem/yardimci_hakem/yazi_hakemi/cizgi_hakemi

  // Kullanıcı isteği: voleybol hakemliğinde de tenisteki gibi admin onayından önce mutlaka
  // kontrol edilmesi gereken bilgiler (TVF sistemiyle uyumlu) — ikortNo/refereeKademe/
  // vizeBelgesiUrl/ilTemsilciligi/specialization tenisle aynı alanlar üzerinden paylaşılıyor
  // (bkz. createListing), sadece bu üçü voleybole özel yeni alanlar.
  vizeAktif          Boolean  @default(false) // "Vize Durumu" — bu sezon vizesinin aktif olduğuna dair kendi beyanı, admin vizeBelgesiUrl ile çapraz kontrol eder
  highestLeagueLevel String?  // "Yönettiği En Yüksek Lig Seviyesi" — Efeler/Sultanlar Ligi, 1. Lig, 2. Lig, Altyapı vb
  recentMatchesUrl   String?  // "En Son Yönettiği Maç Listesi" — opsiyonel, son 1-2 yılda çıktığı maçların listesi/görseli

  location        String?  // kort/tesis adı — artık zorunlu değil, bkz. cities
  city            String?  // eski tekil alan — geriye dönük uyumluluk için duruyor, yeni
  // kayıtlarda kullanılmıyor, bkz. cities
  cities          Json?    // string[] — kullanıcı isteği: konum yerine bir/birden fazla şehir
  // zorunlu (CoachListing.cities ile aynı desen)
  days            Json     @default("[]")
  timeFrom        String   @default("09:00")
  timeTo          String   @default("21:00")

  description     String?
  status          String   @default("ACTIVE")  // ACTIVE | FLAGGED | REMOVED | REJECTED (admin basvuruyu reddetti, bkz. setRefereeApproval)
  reportCount     Int      @default(0)
  // Voleybol/tenis/padelde admin onayı olmadan hakemlik yapılamaz (bkz.
  // resolveRefereeEligibility, rival.controller.js) — CoachListing.approved ile aynı desen.
  // Diğer dallarda (badminton/masa tenisi/airsoft) bu alan kontrol edilmez, ilan yayınlanır
  // yayınlanmaz hakem olarak davet edilebilir.
  approved        Boolean  @default(false)
  adminNote       String?  // kullanıcı isteği: admin reddederken bir açıklama yazabilsin,
  // kullanıcıya bu sebeple bildirim gitsin (bkz. CoachListing.adminNote ile aynı desen)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews         RefereeReview[]
}

// Hakem yorum/puanı — yalnızca o hakemin fiilen hakemlik yaptığı bir maçta
// katılımcı/sahip olanlar verebilir (ActivityRequest.refereeId üzerinden doğrulanır).
model RefereeReview {
  id               String   @id @default(uuid())
  refereeListingId String?  // hakemin o kategori/dalda aktif ilanı varsa bağlanır (genel ortalama puanı için) — zorunlu değil
  refereeUserId    String   // asıl bağ: hakemlik yapan kişi (ActivityRequest.refereeId) — ilanı olmasa da yorum alabilir
  rivalId          String   // hangi maçın hakemliği değerlendiriliyor — maç başına 1 yorum
  reviewerId       String
  // Anket soruları (1-5) — sadece voleybolde soruluyor, diğer dallarda null kalır (sadece
  // rating+comment ile devam ederler, geriye dönük uyumluluk bozulmasın diye).
  ruleKnowledge       Int?  // Kurallara hakimiyet
  decisionConsistency Int?  // Karar tutarlılığı
  fairness            Int?  // Tarafsızlık
  communication       Int?  // İletişim ve otorite
  gameManagement      Int?  // Maç temposunu yönetme
  rating           Int      // 1-5 — anketin sonundaki genel yıldız, maç/hakem ortalamasına giren asıl değer
  comment          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  refereeListing   RefereeListing?  @relation(fields: [refereeListingId], references: [id], onDelete: Cascade)
  refereeUser      User             @relation("RefereeReviewReceived", fields: [refereeUserId], references: [id], onDelete: Cascade)
  rival            ActivityRequest  @relation(fields: [rivalId], references: [id], onDelete: Cascade)
  reviewer         User             @relation("RefereeReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([rivalId, reviewerId])
}

model EquipmentListing {
  id          String   @id @default(uuid())
  userId      String
  category    String
  subCategory String

  condition   String   // NEW | USED
  title       String
  price       Int      @default(0)
  images      Json     @default("[]")  // Cloudinary URL array
  description String?
  location    String?
  city        String?
  status      String   @default("ACTIVE")  // ACTIVE | RESERVED | SOLD | FLAGGED | REMOVED
  reportCount Int      @default(0)

  // Karşılıklı anlaşınca opsiyonlu (RESERVED) hale getirilir — belirlenen tarihe kadar
  // bu alıcı için tutulur, sonra ilan sahibi "Satıldı" ile SOLD'a geçirir.
  reservedForUserId String?
  reservedUntil     DateTime?

  // Satıldı işaretlenirken ilan sahibi, ilan üzerinden konuştuğu kişilerden (teklif verenler +
  // mesajlaşanlar) VEYA kullanıcı adıyla arayıp bulduğu herhangi birini "bana bu satın aldı"
  // olarak seçebilir (maçta karşılaşıp anlaşmış olabilirler) — uygulama içinden mi dışından
  // mı satıldığını görmek için. Seçilmezse (dışarıdan satıldıysa) null kalır. Seçilen kişinin
  // gerçekten onayladığını doğrulamak için: 24 saat içinde onaylamazsa otomatik onaylanır
  // (bkz. jobs/equipmentAutoConfirmSold.js).
  soldToUserId          String?
  soldToConfirmed       Boolean   @default(false)
  soldToConfirmDeadline DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  soldToUser  User?            @relation("EquipmentSoldTo", fields: [soldToUserId], references: [id], onDelete: SetNull)
  offers      EquipmentOffer[]
  messages    Message[]
}

model EquipmentOffer {
  id         String   @id @default(uuid())
  listingId  String
  fromUserId String
  price      Int
  message    String?
  status     String   @default("PENDING") // PENDING | COUNTERED | ACCEPTED | REJECTED | WITHDRAWN
  counterPrice Int?   // İlan sahibinin gönderdiği karşı teklif fiyatı (status=COUNTERED iken dolu)
  createdAt  DateTime @default(now())

  listing    EquipmentListing @relation(fields: [listingId],  references: [id], onDelete: Cascade)
  fromUser   User             @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@unique([listingId, fromUserId])
}

model UserAchievement {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  proofUrl    String?
  achievedAt  String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ListingReport {
  id          String   @id @default(uuid())
  reporterId  String
  listingType String   // EQUIPMENT | COACH
  listingId   String
  reason      String
  createdAt   DateTime @default(now())

  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, listingType, listingId])
}

// AKTİVİTE KARTI (Her kategori için ayrı kart)
model ActivityCard {
  id          String       @id @default(uuid())
  userId      String
  category    CategoryType
  cardLevel   String       @default("BRONZE")
  power       Int          @default(0)
  creativity  Int          @default(0)
  technique   Int          @default(0)
  stamina     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

// GÖNDERI
model Post {
  id           String       @id @default(uuid())
  userId       String
  category     CategoryType
  subCategory  String?
  content      String
  imageUrl     String?
  videoUrl     String?
  type         String       @default("POST")  // POST | REEL | STORY
  targets      Json?                          // [{category, subCategory}, ...]
  hidden       Boolean      @default(false)   // hidden from branches, visible only on own profile
  expiresAt    DateTime?                      // set for STORY type: createdAt + 24h
  muteVideo      Boolean      @default(false)   // mute original video audio
  musicUrl       String?                        // deezer 30s preview mp3
  musicName      String?                        // track title
  musicArtist    String?                        // artist name
  musicCoverUrl  String?                        // album cover image url
  musicStartTime Float?                         // trim start in seconds
  musicEndTime   Float?                         // trim end in seconds
  location       String?                        // optional location tag
  rivalId        String?                        // maç skor girişinden "Medya Paylaş" ile paylaşılan medya —
                                                  // ilişkili ActivityRequest'in id'si (tam ekran görünümde maç
                                                  // detayı gösterebilmek için, bkz. rival.controller.js/getRivalById)
  mediaApprovalStatus String?                    // null = onay gerekmez (rivalId yok ya da skor zaten onaylıydı) |
                                                  // PENDING | APPROVED | REJECTED — skor bekleyen maçta paylaşılan
                                                  // medya karşı taraf onaylayana kadar Medya sekmesinde görünmez
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     Comment[]
  likes        Like[]
  storyViews   StoryView[]
}

// HİKAYE GÖRÜNTÜLEMESİ
model StoryView {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// YORUM — kullanıcı isteği: maç yorumlarındaki (MatchComment) aynı algoritma — silme (viewedBy
// ile "gören oldu mu" uyarısı), yanıtlama (parentId ile tek seviye thread) ve beğeni.
model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  parentId  String?  // dolu ise bu bir yanıt — sadece o üst yoruma bağlı, tek seviye
  content   String
  viewedBy  Json     @default("[]")
  createdAt DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]
}

// YORUM BEĞENİSİ
model CommentLike {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

// BEĞENİ
model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// MÜZİK — çalma listesi (şarkılar sıralı Json dizi, ayrı join tablosu yok — kod
// tabanındaki diğer sıralı-küçük-liste alanlarıyla (senderTeam, participants vb.) aynı desen)
model Playlist {
  id        String   @id @default(uuid())
  userId    String
  name      String
  tracks    Json     @default("[]") // [{trackId,title,artist,imageUrl,streamUrl,duration}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MÜZİK — beğenilen şarkı (dış API'den gelen track meta verisi önbelleğe alınır,
// her listelemede tekrar dış API'ye sorulmasın diye)
model LikedTrack {
  id        String   @id @default(uuid())
  userId    String
  trackId   String   // Jamendo track id (dış kaynak, FK değil)
  title     String
  artist    String
  imageUrl  String?
  streamUrl String
  duration  Int?
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

// TAKİP — istek/onay gerektirir (PENDING -> ACCEPTED | REJECTED), her yon birbirinden bagimsizdir
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  follower    User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

// AKTİVİTE İSTEĞİ (Rakip, partner, takım arkadaşı)
model ActivityRequest {
  id              String       @id @default(uuid())
  senderId        String
  receiverId      String?
  category        CategoryType
  subCategory     String
  message         String?
  wager           String?   // "bizi yenene saha ücretsiz", "beni yenene dondurma" gibi eğlence amaçlı bahis/ödül metni (tenis/padel/voleybol)
  level           String?
  location        String?
  district        String?
  ticketUrl       String?   // Sanat kategorisi (tiyatro/müzik/sinema vb.) için gerçek bilet satış sayfası linki
  courtName       String?
  courtAddress    String?
  courtLat        Float?
  courtLng        Float?
  venueId              String?   // işletme tesisi bağlantısı
  venueCourtId         String?
  venueReservationId   String?   // hangi rezervasyondan oluşturuldu
  isCourtReserved    Boolean      @default(false)
  courtFeePerPerson  Int?
  courtFeePerPersonByMethod Json?   // {CASH,EFT,ONLINE,CREDIT_CARD} -> kişi başı ücret — sadece bilgi amaçlı, katılımcı hangi yöntemle öderse o tutarı görsün diye
  feeIncludes        String?  // kort/mekan yerine sadece ücretli/ücretsiz seçimi olan dallarda (örn. SUP&Kano) ücrete nelerin dahil olduğunun açıklaması — courtFeePerPerson zaten tutarı tutuyor
  flexibleSchedule   Boolean      @default(false)
  matchDate          DateTime?
  matchTime       String?
  levelDetail     String?
  matchType       String       @default("SINGLE") // SINGLE | DOUBLE
  teamFlexibility String       @default("FLEXIBLE") // FLEXIBLE | STRICT — Çiftler maçlarda pozisyon değiştirmeye (swap-positions) izin var mı
  participantsCanInvite Boolean @default(false)     // kabul edilmiş katılımcılar da (ilan sahibi dışında) oyuncu davet edebilir / ilanı paylaşabilir mi
  matchMode       String       @default("PRACTICE") // PRACTICE | COMPETITIVE
  surface         String?                           // for volleyball: INDOOR | BEACH | GRASS | STREET | CLAY
  teamSize        Int          @default(1)          // players per side (1–6 for volleyball)
  duration        Int?                              // match duration in minutes
  participants    Json         @default("[]")     // [{id, username, fullName}]
  senderTeam      Json         @default("[]")     // team sports (football/volleyball): creator's additional teammates — real users [{id,username,fullName,skillRating}] or guests [{manualName}]
  substitutePlayers Json       @default("[]")     // voleybol: yedek oyuncular — senderTeam ile aynı şekil (gerçek kullanıcı veya {manualName}), taraf bağımsız
  substituteCount Int          @default(0)        // voleybol: ilan sahibinin istediği yedek KONTENJANI (create formundaki subCount ile aynı) — substitutePlayers doluluğundan bağımsız, açık ilanda da değiştirilebilir
  unassignedPlayers Json       @default("[]")     // voleybol: açık ilana katılıp henüz Kurucu/Rakip'e atanmamış oyuncular — ilan sahibi Yaklaşan Maçlar kartından elle atar (bkz. assignPlayerToSide)
  waitlistPlayers Json         @default("[]")     // DOUBLE/SINGLE (tenis/padel/badminton/masa tenisi): kadro (kurucu+katılımcılar+atanmamışlar) TAMAMEN dolduktan SONRA kabul edilen davetler/başvurular buraya düşer — biri kadrodan çıkınca ilk sıradaki otomatik olarak unassignedPlayers'a terfi eder (bkz. placeInDoubleWaitlistOrReject/removeRivalParticipant)
  substitutePromotedAt Json    @default("{}")     // voleybol: { [userId]: ISO tarih } — yedekten asıl kadroya terfi anı. Terfi ettirilen kişi, iptal politikası uymasa bile terfiden sonraki 1 saat içinde şartsız çıkabilir (bkz. leaveAsPromotedSubstitute)
  founderPosition String?                         // voleybol: ilan sahibinin (kurucu) kendi Libero/Pasör/Smaçör pozisyonu — kurucu senderTeam/participants dizilerinde değil, sender ilişkisinde tutulduğu için ayrı alan (bkz. setParticipantPosition)
  positionSuggestions Json     @default("[]")     // voleybol: [{userId, position, createdAt}] — ilan sahibi olmayan katılımcının kendisi için önerdiği, ilan sahibinin onayını bekleyen pozisyon (bkz. suggestOwnPosition/respondPositionSuggestion)
  oppTeamManualNames Json      @default("[]")     // team sports: opponent-side names typed in for players without an app account (display-only, ["Ahmet Yılmaz", ...])
  positions       Json         @default("[]")     // e.g. ['REFEREE'] | ['REFEREE_OFFER'] | ['GOALKEEPER']
  extraServices   Json         @default("[]")     // [{id,type,name,price,artistListingId?}] — DJ/Sanatçı/Mangal Partisi vb. ek hizmetler (tenis/padel/voleybol)
  refereePayment  String?                         // fee offered or rate per match
  refereeFeeIncluded Boolean  @default(false)     // true = hakem ücreti hizmetler/kort fiyatına dahil, ayrı ücret yok (refereePayment o zaman boş kalır)
  refereeRequested Boolean     @default(false)    // bu maç ilanı için hakem talep edildi mi (tenis/padel/voleybol)
  manualRefereeName String?                       // sisteme kayıtlı olmayan hakem için serbest metin isim (tenis/padel/voleybol)
  linkedRivalId   String?                         // hakem-arama ilanıysa (matchType PLAYER_WANTED, positions:['REFEREE']) bağlı olduğu asıl maç ilanının id'si
  refereeFeePerPerson Int?                        // hakemle fiyatta anlaşıldığında, hakem ücretinin oyuncu sayısına eşit bölünmüş payı (asıl maç ilanında tutulur)
  refereeId       String?                         // asıl maç ilanında: onaylanmış hakemin userId'si (hakem slotu)
  refereeDisputeVoterIds Json @default("[]")      // mevcut hakeme itiraz eden kadro üyelerinin userId listesi — çoğunluğa ulaşınca hakem çıkarılır (bkz. disputeReferee), refereeId her değiştiğinde sıfırlanır
  refereeQueue    Json         @default("[]")     // [{userId, username, fullName, avatar, offerPrice}] — refereeId zaten doluyken kabul edilen yeni hakem davetleri buraya sıraya girer, hemen atanmaz; mevcut hakem çıkınca (bkz. disputeReferee) ilk sıradaki otomatik refereeId olur
  minRating       Float?                          // min skill rating to join
  maxRating       Float?                          // max skill rating to join
  ratingGenderSplit Boolean   @default(false)      // true ise minRating/maxRating yerine cinsiyete göre ayrı aralıklar (aşağıda) kullanılır
  minRatingMale     Float?                         // ratingGenderSplit true iken erkek oyuncular için alt derece sınırı
  maxRatingMale     Float?                         // ratingGenderSplit true iken erkek oyuncular için üst derece sınırı
  minRatingFemale   Float?                         // ratingGenderSplit true iken kadın oyuncular için alt derece sınırı
  maxRatingFemale   Float?                         // ratingGenderSplit true iken kadın oyuncular için üst derece sınırı
  status          String       @default("OPEN")   // OPEN | MATCHED | CANCELLED | COMPLETED
  // Maç MATCHED iken bir katılımcı çıkarılınca/ayrılınca OPEN'a dönerse damgalanır —
  // bu slot yeniden dolana kadar (MATCHED'e geri dönene kadar) kalıcıdır. Bu süre
  // boyunca kabul edilen HERHANGİ bir istek, süre farketmeksizin joiner'dan son onay
  // ister (bkz. respondToJoin'deki lateAccept) — çünkü başvuranın koşulları değişmiş
  // olabilir. Ayrıca bu ilana bekleyen istek göndermiş olan herkese "ilan tekrar açıldı"
  // bildirimi gider.
  reopenedAt      DateTime?
  score           Json?                           // {sets:[{sender:6,opponent:3},...], winner:"sender"|"opponent"}
  scoreStatus     String       @default("NONE")   // NONE | PENDING | CONFIRMED | DISPUTED
  scoreEnteredBy  String?
  scoreAppeal       Boolean  @default(false)
  scoreAppealReason String?
  completedAt     DateTime?
  archived        Boolean      @default(false)
  expiresAt            DateTime?
  mutualCancelRequests Json     @default("[]") // [userId, ...] — tracks who requested mutual cancel
  cancelPenaltyHours Int?                      // voleybol: kurucunun belirlediği "maça X saat kala tek taraflı iptal cezalı" eşiği — doluysa genel 5 saat/-0.20 kuralı yerine bu ilana özel X saat/-0.10 puan kuralı uygulanır (bkz. cancelMatch)
  genderReq        String  @default("MIX")  // MIX | MALE | FEMALE — who can join (singles: opponent; display hint for doubles)
  partnerGenderReq String  @default("MIX")  // doubles: partner/teammate gender requirement
  opp1GenderReq    String  @default("MIX")  // doubles: opponent 1 gender requirement
  opp2GenderReq    String  @default("MIX")  // doubles: opponent 2 gender requirement
  requiredMaleCount Int?                   // voleybol takım ilanı: havuzun (2*teamSize kişi) kaç kişisi erkek olmalı — null = kısıtlama yok. Kadın sayısı 2*teamSize - requiredMaleCount olarak hesaplanır, takım büyüklüğü değişirse buna göre yeniden değerlendirilir.
  genderCountMode  String?                 // 'EXACT' (requiredMaleCount, yukarıdaki eski davranış) | 'MIN' (havuzun tamamında minGenderReq/minGenderCount) | 'MIN_PER_TEAM' (her iki takımda AYRI AYRI aynı alanlar) | null = kısıtlama yok
  minGenderReq     String?                 // 'MIN' modda: 'MALE' | 'FEMALE' — hangi cinsiyetten minimum isteniyor
  minGenderCount   Int?                    // 'MIN' modda: en az kaç kişi — kalan slotların cinsiyeti serbest (kullanıcı isteği: "2 kesin kız lazım, kalanı fark etmez")
  winsNeeded       Int?                    // örn. airsoft: kaç raunt/oyun kazanınca maç biter — null = belirtilmemiş
  founderTeamName  String?                 // DOUBLE veya voleybol takımı: kurucu takımın (ilan sahibi + partner/takım arkadaşları) isteğe bağlı özel takım adı
  opponentTeamName String?                 // DOUBLE veya voleybol takımı: rakip takımın (opp1+opp2 veya katılımcılar) isteğe bağlı özel takım adı
  scheduleProposal    Json?                   // {userId, date, time, location, courtName, proposedAt}
  schedulingDeadline  DateTime?               // 24h after MATCHED for flexible matches
  abandonProposal     Json?                   // Voleybolde "Skor Girilemiyor" (berabere/arşiv ya da yeniden planlama) çoğunluk onayı bekleyen teklif: {reason, initiatorId, voterIds:[], newDate?, newTime?, newCourtName?, newLocation?, partialSets?, createdAt} — bkz. abandonMatch
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sender          User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User? @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  joinRequests    RivalJoinRequest[]
  matchComments   MatchComment[]
  noShowReports   NoShowReport[]
  matchPeerReviews MatchPeerReview[]
  linkedRival     ActivityRequest?  @relation("RefereeLink", fields: [linkedRivalId], references: [id], onDelete: Cascade)
  refereeAds      ActivityRequest[] @relation("RefereeLink")
  refereeUser     User?  @relation("MatchRefereeUser", fields: [refereeId], references: [id], onDelete: SetNull)
  refereeReviews  RefereeReview[]
  spectators      MatchSpectator[]
}

// Voleybolda bir ilana "seyirci" olarak katılım kaydı. Amaç: onaylı antrenörlerin sadece
// SEYİRCİ olarak katıldıkları (izledikleri) maçlardaki oyuncuları değerlendirebilmesi —
// eskiden onaylı bir antrenör hiçbir kısıt olmadan HERHANGİ bir oyuncuyu değerlendirebiliyordu
// (bkz. resolveRaterRole/hasSpectatedVolleyballMatch, backend/src/utils/volleyballRating.js).
// Seyirci olarak katılmak herkese açık — sadece antrenörler için (COACH rolü) bir ön koşul.
model MatchSpectator {
  id                String   @id @default(uuid())
  activityRequestId String
  userId            String
  createdAt         DateTime @default(now())
  // Maç kadrosundan (iki takım) "bu kişi seyirci olarak gelmedi, sahte" diyerek itiraz eden
  // oyuncuların id listesi. Kadronun yarısından fazlası itiraz edince (bkz. disputeSpectator,
  // spectator.controller.js) bu kayıt silinir ve varsa bu seyirciliğe dayanan COACH
  // değerlendirmesi geçersiz kılınır.
  disputeVoterIds   Json     @default("[]")

  activityRequest ActivityRequest @relation(fields: [activityRequestId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityRequestId, userId])
}

model MatchComment {
  id        String   @id @default(uuid())
  rivalId   String
  userId    String
  content   String
  // Kullanıcı isteği: yorumu silmeden önce "bu yorumu gören oldu mu" uyarısı — yazarı hariç
  // yorumu görüntüleyen her kullanıcının id'si burada birikir (bkz. getMatchComments).
  viewedBy  Json     @default("[]")
  createdAt DateTime @default(now())

  rival     ActivityRequest @relation(fields: [rivalId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NoShowReport {
  id            String   @id @default(uuid())
  rivalId       String
  reporterId    String
  absentUserIds Json     @default("[]")  // [userId, ...]
  courtPhotoUrl String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  subCategory   String
  category      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rival         ActivityRequest @relation(fields: [rivalId],    references: [id], onDelete: Cascade)
  reporter      User            @relation("noShowReporter", fields: [reporterId], references: [id], onDelete: Cascade)
}

// AKRAN DOGRULAMA — voleybol maci sonrasi takim arkadaslari/rakipler birbirini
// puanlar (teknik+mental), skillRating'e trust-agirlikli+medyan-filtreli harman
// olarak yansitilir. AssessmentVote'tan (kart oylama) tamamen ayri, farkli amac.
model MatchPeerReview {
  id                 String   @id @default(uuid())
  matchId            String                          // ActivityRequest.id
  reviewerId         String
  revieweeId         String
  subCategory        String                          // simdilik sadece 'volleyball'
  technicalStars     Int                              // 1-5, manset/pas
  mentalStars        Int                              // 1-5, takim uyumu
  isPremade          Boolean  @default(false)         // ayni onceden-grup taraf -> harmanlamaya girmez
  trustWeightApplied Float    @default(1.0)           // oyu verenin oy ANINDAKI trustScore'u
  createdAt          DateTime @default(now())

  match     ActivityRequest @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reviewer  User @relation("PeerReviewGiven",    fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee  User @relation("PeerReviewReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([matchId, reviewerId, revieweeId])
  @@index([revieweeId, subCategory])
}

// Idempotency defteri: 0.9/0.1 harman formulu mac+kullanici basina TAM BIR KEZ
// uygulanir (tekrar calisirsa katlanir), bu tablo bunu garanti eder + denetim izi sunar.
model PeerReviewBlend {
  id                String   @id @default(uuid())
  matchId           String
  userId            String
  subCategory       String
  peerAverage       Float
  votesUsed         Int
  skillRatingBefore Float
  skillRatingAfter  Float
  appliedAt         DateTime @default(now())

  @@unique([matchId, userId])
}

model RivalJoinRequest {
  id          String   @id @default(uuid())
  rivalId     String
  userId      String
  status      String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  joiningTeam Json     @default("[]")      // COMPETITIVE team: challenger's full team [{id,username,fullName,skillRating}]
  initiatedBy     String   @default("JOINER")  // JOINER (user asked to join) | OWNER (owner invited this user)
  isPartnerInvite Boolean  @default(false)      // OWNER davet: kurucu takımına (DOUBLE'da partner, takım sporlarında Kurucu Takım) doğrudan davet — kabul edilince senderTeam'e eklenir
  isOppTeamInvite Boolean  @default(false)      // OWNER davet: takım sporlarında (voleybol/airsoft) Rakip Takım'a doğrudan davet — kabul edilince participants'a eklenir (atanmamış havuzuna değil)
  isSubstituteInvite Boolean @default(false)    // OWNER davet: voleybolde yedek oyuncu daveti — kabul edilince substitutePlayers'a eklenir
  isUnassignedInvite Boolean @default(false)    // OWNER davet: ilan oluşturulurken hangi takımda oynayacağı henüz belirlenmemiş oyuncu daveti — kabul edilince unassignedPlayers'a eklenir (ilan sahibi sonradan Kurucu/Rakip'e atar)
  partnerId       String?                       // Çiftler (DOUBLE): tek başına başvurmuş kullanıcının istediği partnerin userId'si. Karşılıklı olunca (iki başvuru da birbirini gösterince) çift eşleşir.
  offerPrice      String?                       // Hakem başvurusu: teklif edilen ücret
  offerMessage    String?                       // Hakem başvurusu: ek bilgi/mesaj
  offerCvUrl      String?                       // Hakem başvurusu: CV linki (varsa)
  counterPrice    String?                       // Hakem başvurusu: karşı teklif fiyatı (status=COUNTERED iken dolu)
  counterMessage  String?                       // Hakem başvurusu: karşı teklifle birlikte gönderilen mesaj
  requestedSlot   String?                       // İki kullanımı var: (1) Çiftler (DOUBLE) + teamFlexibility=STRICT, initiatedBy='JOINER': başvuru sırasında seçilen hedef taraf — 'partner' | 'opponent'. (2) Çiftler (DOUBLE), initiatedBy='OWNER': Digimon kart'tan Rakip 1/Rakip 2 formasına doğrudan davet — 'opp1' | 'opp2' (bkz. inviteToRival/respondToJoin). Yazım ve initiatedBy farklı olduğu için asla çakışmaz.
  slotIndex       Int?                          // Takım sporlarında (voleybol/airsoft) isPartnerInvite/isOppTeamInvite daveti kadro kartındaki HANGİ sıradaki forma yazıldıysa (0-index) — kabul edilince kişi senderTeam/participants dizisinde bu index'e yerleşir, dizinin sonuna değil (kullanıcı isteği: "hangi forma yazıldıysa orada kalsın").
  positionPreferences Json?                     // Voleybol: başvuran kişinin oynamak istediği pozisyon(lar), öncelik sırasıyla — ["SETTER","SPIKER"] gibi (ilk eleman en yüksek öncelik). İlan sahibi İstekler listesinde bunu görüp kabul/red kararını buna göre verebiliyor (bkz. sendJoinRequest/kullanıcı isteği).
  createdAt   DateTime @default(now())

  rival      ActivityRequest @relation(fields: [rivalId],  references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@unique([rivalId, userId])
}

// ŞEHİR / İL / İLÇE
model City {
  id         String   @id @default(uuid())
  province   String
  district   String?
  status     String   @default("PENDING")  // PENDING | APPROVED
  createdAt  DateTime @default(now())

  @@unique([province, district])
}

// TURNUVA/ETKİNLİK
model Tournament {
  id             String       @id @default(uuid())
  name           String
  type           String?      @default("mix_double") // '1'..'8' (bkz. TOURN_TYPES) — anket açıksa (status=POLL) anket kapanana kadar null
  category       CategoryType
  subCategory    String
  description    String?
  scope                String       @default("YEREL")  // YEREL | ULUSAL | ULUSLARARASI
  genderType           String       @default("MIX")    // KADIN | ERKEK | MIX
  isPaid               Boolean      @default(false)
  feeType              String?      // INCLUDED (court fee in price) | SHARED (court costs split)
  playerFee            Float?       // fee per player in local currency
  paymentMethod        String?      // EFT | CASH
  ibanNumber           String?
  ibanHolder           String?
  prize1               String?
  prize2               String?
  prize3               String?
  surpriseGifts        String?  // isteğe bağlı, ödüllerin yanına ek bilgi amaçlı "sürpriz hediyeler" notu
  contactPhone         String?
  minRating            Float?       // minimum skillRating to join (0.0–5.0)
  maxRating            Float?       // maximum skillRating to join (0.0–5.0)
  ratingGenderSplit    Boolean      @default(false) // true ise minRating/maxRating yerine cinsiyete göre ayrı aralıklar (aşağıda) kullanılır — genderType MIX iken anlamlı
  minRatingMale        Float?       // ratingGenderSplit true iken erkek katılımcılar için alt derece sınırı
  maxRatingMale        Float?       // ratingGenderSplit true iken erkek katılımcılar için üst derece sınırı
  minRatingFemale      Float?       // ratingGenderSplit true iken kadın katılımcılar için alt derece sınırı
  maxRatingFemale      Float?       // ratingGenderSplit true iken kadın katılımcılar için üst derece sınırı
  matchmakingType      String?      // 'ELO' | 'RANDOM' | 'SEEDED'
  matchFrequency       String?      // 'WEEKLY_1' | 'WEEKLY_2' | 'FLEXIBLE'
  matchTimeStart       String?      // earliest allowed match time e.g. '09:00'
  matchTimeEnd         String?      // latest allowed match time e.g. '22:00'
  dayTrip              Boolean      @default(false) // Günübirlik: tüm maçlar tek günde oynanır — joker/haftalık süre kuralları (3./4. madde) geçersizdir
  minPlayers           Int          @default(2)
  maxPlayers           Int          @default(32)
  setsPerMatch         Int?         // 1 | 3 | 5
  advantageScoring     Boolean?     @default(true)   // true=avantajlı, false=karar puanı, null=serbest
  matchesBeforePlayoff Int?         // play-off öncesi kaç maç
  playoffQualifiers    Int?         // play-off'a kaç kişi kalır
  teamSize             Int?         // airsoft vb. takım tabanlı dallarda her takımın kişi sayısı (min/max oyuncu yerine)
  teamRequiredMaleCount Int?        // teamSize'ın kaçı erkek olmalı — null = kısıtlama yok (bkz. ActivityRequest.requiredMaleCount ile aynı mantık)
  location       String?
  city           String?      // il (YEREL) | ülke (ULUSAL) | Dünya (ULUSLARARASI)
  surface        String?      // clay | hard | grass | carpet | sand | artificial
  isIndoor       Boolean      @default(false)
  eventDate      DateTime?
  eventTime      String?      // tournament start time e.g. "10:00"
  eventEndDate   DateTime?    // estimated tournament end date
  eventEndTime   String?      // estimated tournament end time e.g. "18:00"
  startTime      String?      // registration start time
  endTime        String?      // registration end time
  startDate      DateTime?
  endDate        DateTime?
  pollEndDate    DateTime?    // anket bitiş tarihi (tür anketi açıksa)
  pollEndTime    String?      // anket bitiş saati, örn. "18:00"
  pollTypes      Json?        // anket açıksa, oylamaya sunulan tür ID'leri, ör. ["1","2"] — turnuvayı açan kişi seçer
  status         String       @default("OPEN")  // OPEN | IN_PROGRESS | COMPLETED | CANCELLED | POLL
  creatorId      String
  rules          Json?        @default("[]") // seçili kural ID'leri örn. [1, 2, 3]
  extraServices  Json?        @default("[]") // [{id,type,name,price,artistListingId?}] — DJ/Sanatçı/Mangal Partisi vb. ek hizmetler
  bracketData    Json?        // standings + phase info
  ratingSnapshot Json?        // {userId: {username, fullName, totalPoints, skillRating}}
  completedAt    DateTime?
  startedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  creator          User         @relation("tournamentCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants     TournamentParticipant[]
  typeVotes        TournamentTypeVote[]
  tournamentMatches TournamentMatch[]
  messages         TournamentMessage[]
  chatNotifyPrefs  TournamentChatNotify[]
  teams            TournamentTeam[]
  tournamentCourts TournamentCourt[]
  courtBlocks      CourtBlock[]
}

// TURNUVA GRUP SOHBETI — turnuva sahibi + AS/yedek olarak onaylanmis tum katilimcilar
model TournamentMessage {
  id           String   @id @default(uuid())
  tournamentId String
  senderId     String
  content      String
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// Turnuva sohbeti icin kisi bazli bildirim tercihi — varsayilan kapali, kullanici acarsa bildirim gider
model TournamentChatNotify {
  id           String  @id @default(uuid())
  tournamentId String
  userId       String
  enabled      Boolean @default(false)

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model TournamentMatch {
  id           String   @id @default(uuid())
  tournamentId String
  round        Int
  phase        String   @default("GROUP")   // GROUP | PLAYOFF
  matchIndex   Int      @default(0)
  p1Id         String?
  p1Name       String?
  p2Id         String?
  p2Name       String?
  score              Json?     // {sets:[{p1:X,p2:Y},...], winner:'p1'|'p2', p1Sets:N, p2Sets:N, p1Games:N, p2Games:N}
  status             String    @default("PENDING") // PENDING | COMPLETED | BYE | FORFEIT
  winnerId           String?
  deadline           DateTime?
  readyAt            DateTime? // PLAYOFF: iki taraf da belli olunca (kura/eleme anında) damgalanır — turnuva sahibine
                                // yeni tur için tarih atamasi icin 3 gunluk sure buradan sayilir, atamazsa +7 gun otomatik verilir
  p1JokerRequested   Boolean   @default(false)
  p2JokerRequested   Boolean   @default(false)
  scoreEnteredBy     String?   // skoru giren kullanıcının id'si — kendi tarafı otomatik onaylanır
  p1Confirmed        Boolean   @default(false) // p1 tarafından biri (Çiftler'de takım üyesi) skoru onayladı
  p2Confirmed        Boolean   @default(false) // p2 tarafından biri skoru onayladı — ikisi de true olunca skor kilitlenir, Düzelt kalkar
  scoreSubmittedAt   DateTime? // skor en son ne zaman girildi — karşı taraf 1 saat içinde onaylamazsa otomatik onaylanır
  courtId            String?
  createdAt          DateTime  @default(now())
  // 3.'lük maçı — her iki yarı final bitince otomatik oluşturulur (round=final'in round'u,
  // matchIndex=1, final her zaman matchIndex=0 olduğu için asla çakışmaz). İki taraf da
  // p*ThirdPlaceAccepted=true olmadan oynanmaz; biri false derse maç status='FORFEIT' olur
  // ve 3./4. sıra yarı final averajından belirlenir (bkz. tournament.controller.js).
  isThirdPlaceMatch     Boolean  @default(false)
  p1ThirdPlaceAccepted  Boolean?
  p2ThirdPlaceAccepted  Boolean?

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  court        Court?     @relation(fields: [courtId], references: [id], onDelete: SetNull)
}

// TURNUVA KATILIMCI / JOIN REQUEST
model TournamentParticipant {
  id              String   @id @default(uuid())
  tournamentId    String
  userId          String?
  manualName      String?  // set when userId is null (manual participant added by creator)
  partnerId       String?  // Çiftler Rekabetçi (type '2'): requested partner's userId. Mutual when both name each other; otherwise solo → auto-paired by ELO at tournament start.
  status          String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  note            String?
  cancelRequested Boolean   @default(false)
  cancelReason    String?
  jokerUsed       Boolean   @default(false)
  jokerUsedAt     DateTime?
  mutualJokerUsed Boolean   @default(false)  // karsilikli joker onayi - turnuva basina 1 kez
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

// TURNUVA TÜR ANKETİ — status=POLL iken kullanıcılar '1' (Bireysel) veya '2' (Çiftler) için oy verir
model TournamentTypeVote {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  votedType    String   // Tournament.pollTypes içindeki tür ID'lerinden biri, ör. '1'..'8'
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

// Çiftler Rekabetçi (Tournament.type == '2'): bir maç tarafı bir kullanıcı değil, bu takımdır.
// TournamentMatch.p1Id/p2Id bu durumda User id değil TournamentTeam id tutar.
model TournamentTeam {
  id            String   @id @default(uuid())
  tournamentId  String
  player1Id     String
  player1Name   String
  player2Id     String
  player2Name   String
  avgRating     Float    @default(0)
  createdAt     DateTime @default(now())

  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// ETKİNLİK (Konser, sergi, oyun turnuvası vb.)
model Event {
  id           String       @id @default(uuid())
  name         String
  category     CategoryType
  subCategory  String
  description  String?
  location     String?
  isOnline     Boolean      @default(false)
  maxAttendees Int?
  startDate    DateTime
  endDate      DateTime?
  status       String       @default("UPCOMING")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  participants EventParticipant[]
}

// ETKİNLİK KATILIMCI
model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}
model Court {
  id          String   @id @default(uuid())
  name        String
  address     String?
  city        String
  district    String?
  country     String?
  lat         Float?
  lng         Float?
  sport       String   @default("tennis")
  surface     String?
  indoor      Boolean  @default(false)
  fee         Boolean  @default(false)
  feeAmount   String?
  lights      Boolean  @default(false)
  description String?
  phone       String?                            // topluluk kaydında opsiyonel — çoğu zaman boş, herhangi bir kullanıcı sonradan tamamlayıp önerebilir
  courtCount  Int?                               // kaç kort/saha olduğu (bilgi amaçlı)
  openDays    Json?                              // [1..7] (1=Pzt..7=Paz) — bilinmiyorsa null
  openTime    String?
  closeTime   String?
  addedBy     String
  verified      Boolean  @default(false)
  pending       Boolean  @default(true)   // true until admin reviews
  rejectedReason String?
  pendingEdit    Json?                              // eksik/hatalı bilgiyi tamamlamak için herhangi bir kullanıcının gönderdiği, admin onayı bekleyen alan güncellemesi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [addedBy], references: [id], onDelete: Cascade)
  tournamentCourts TournamentCourt[]
  blocks           CourtBlock[]
  matchAssignments TournamentMatch[]
  ratings          CourtRating[]
}

model CourtRating {
  id        String   @id @default(uuid())
  courtId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId],  references: [id], onDelete: Cascade)

  @@unique([userId, courtId])
}

// Wikiloc tarzı GPS rota paylaşımı (şu an sadece "hiking" dalı için) —
// kullanıcılar kendi yürüdükleri güzergahı kaydedip paylaşabilir (source
// USER), admin de dış kaynaklardan (GPX vb.) topladığı rotaları "onaylı"
// olarak ekleyebilir (source CURATED, verified true).
model Trail {
  id            String   @id @default(uuid())
  creatorId     String
  subCategory   String   // 'hiking' — sabit kodlanmadı, ileride diğer dallara açılabilir
  title         String
  description   String?
  city          String?
  district      String?
  distanceKm    Float
  elevationGain Float?
  durationMin   Int?
  difficulty    String   @default("MEDIUM") // EASY | MEDIUM | HARD
  path          Json                        // [{lat,lng,ele?,t?}, ...] GPS iz noktaları
  startLat      Float?
  startLng      Float?
  images        Json     @default("[]")     // Cloudinary URL dizisi
  source        String   @default("USER")   // USER | CURATED
  verified      Boolean  @default(false)    // CURATED ise otomatik true — "Onaylı" rozeti
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator  User            @relation("TrailCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  reviews  TrailReview[]
  comments TrailComment[]

  @@index([subCategory, city])
}

model TrailReview {
  id        String   @id @default(uuid())
  trailId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user  User  @relation("TrailReviewUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trailId])
}

model TrailComment {
  id        String   @id @default(uuid())
  trailId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  trail Trail @relation(fields: [trailId], references: [id], onDelete: Cascade)
  user  User  @relation("TrailCommentUser", fields: [userId], references: [id], onDelete: Cascade)
}

// ARKADAŞLIK
model Friendship {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING | ACCEPTED | REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender     User @relation("friendshipSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver   User @relation("friendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

// ENGELLEME
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// MESAJ ENGELİ — Block'tan farklı, sadece mesajlaşmayı durdurur; arkadaşlık/takip/
// arama/profil görüntüleme gibi diğer her şey etkilenmez.
model MessageBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User @relation("msgBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("msgBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// KONUŞMA (DM)
model Conversation {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1     User      @relation("convUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("convUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]
  mutes     ConversationMute[]

  @@unique([user1Id, user2Id])
}

// Bir kullanıcının belirli bir sohbeti sessize alması — karşı taraf için ayrı ayrı
// geçerlidir. mutedUntil null ise süresiz sessize alınmış demektir; ileri bir tarihse
// o tarihe kadar. Satır yoksa veya mutedUntil geçmişte kaldıysa sessiz değildir.
model ConversationMute {
  id             String    @id @default(uuid())
  userId         String
  conversationId String
  mutedUntil     DateTime?
  createdAt      DateTime  @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
}

// BİLDİRİM
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // JOIN_REQUEST | MATCH_CONFIRMED | MATCH_CANCELLED | FRIEND_REQUEST | MESSAGE
  title     String
  body      String
  read      Boolean  @default(false)
  data      Json?    // {rivalId, requestId, fromUserId, ...}
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MESAJ
model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean      @default(false)
  readAt         DateTime?    // karşı taraf mesajın içine girip gördüğünde damgalanır
  createdAt      DateTime     @default(now())

  // Fotoğraf / sesli mesaj — content boş olabilir, bu durumda medyanın kendisi mesajdır.
  imageUrl       String?
  audioUrl       String?
  audioDuration  Int?         // saniye

  // Bir ekipman ilanı üzerinden "Sohbet Aç" ile başlatılan mesajlar, hangi ilan hakkında
  // olduğunu taşır — sohbet ekranında ilan kartı gösterilir, bildirime tıklanınca ilana gidilir.
  equipmentListingId String?
  equipmentListing   EquipmentListing? @relation(fields: [equipmentListingId], references: [id], onDelete: SetNull)

  // "İletişime Geç" ile bir antrenör ilanı üzerinden başlatılan mesajlar, hangi ilan
  // hakkında olduğunu taşır — sohbet ekranında ilan kartı gösterilir.
  coachListingId String?
  coachListing   CoachListing? @relation(fields: [coachListingId], references: [id], onDelete: SetNull)

  // Gönderen "Herkesten Sil" derse true olur — içerik/medya temizlenir, her iki
  // tarafta da "Bu mesaj silindi" yer tutucusu gösterilir. "Benden Sil" ise bunu
  // etkilemez, sadece o kullanıcı için MessageDeletion satırı eklenir.
  deletedForEveryone Boolean @default(false)
  deletions          MessageDeletion[]

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// Bir kullanıcının bir mesajı sadece kendi görünümünden sildiği ("Benden Sil")
// durumu — karşı taraf mesajı normal şekilde görmeye devam eder.
model MessageDeletion {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// ŞEHİR UYARISI ABONELİĞİ
model CityAlert {
  id          String   @id @default(uuid())
  userId      String
  city        String
  subCategory String
  tab         String   @default("rivals")  // rivals | tournaments | coaches | equipment
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subCategory, city, tab])
}

// AKTİVİTE BİLDİRİM FİLTRESİ — kullanıcı başına tek bir kayıt; kategori/alt-kategori,
// konum (yakınlık yarıçapı ve/veya seçili şehirler) ve favori sanatçı adlarına göre
// tüm alanları boş bırakırsa o filtre "tümü" anlamına gelir (bkz. activityAlert.controller.js).
model ActivityAlert {
  id              String   @id @default(uuid())
  userId          String   @unique
  enabled         Boolean  @default(true)
  categories      String[] @default([])
  subCategories   String[] @default([])
  cities          String[] @default([])
  useProximity    Boolean  @default(false)
  radiusKm        Int?
  favoriteArtists String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// DIŞ KAYNAKLI (Ticketmaster) ETKİNLİK BİLDİRİM KAYDI — konser/tiyatro cron'unun
// aynı etkinlik için bir kullanıcıya tekrar tekrar bildirim atmasını engeller.
model NotifiedExternalEvent {
  id          String   @id @default(uuid())
  userId      String
  externalId  String   // Ticketmaster event id
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
}

// ABONELİK TALEBİ (EFT dekont onayı bekliyor)
model SubscriptionRequest {
  id          String   @id @default(uuid())
  userId      String
  packageType String   @default("STARTER")
  receiptUrl  String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Voleybol "Resmi Takım Adı" — kullanıcı istediği bir takım ismi için bağış dekontu yükleyip
// başvurur, admin onaylarsa o isim (küçük/büyük harf farksız) TEK BAŞINA o kullanıcıya ait
// olur, başka kimse aynı ismi onaylatamaz (bkz. migration'daki kısmi unique index — sadece
// APPROVED satırlar arasında geçerli, PENDING/REJECTED aynı ismi tekrar deneyebilir).
model TeamNameRequest {
  id          String   @id @default(uuid())
  userId      String
  teamName    String
  receiptUrl  String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// İŞLETME ABONELİĞİ
model BusinessSubscription {
  id          String   @id @default(uuid())
  userId      String
  packageType String   @default("STARTER") // STARTER | PRO | ENTERPRISE
  status      String   @default("ACTIVE")  // ACTIVE | EXPIRED | CANCELLED
  startDate   DateTime @default(now())
  endDate     DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// TURNUVA KORTU — işletme kortlarını turnuvaya bağlar
model TournamentCourt {
  id           String   @id @default(uuid())
  tournamentId String
  courtId      String
  createdAt    DateTime @default(now())

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  court        Court      @relation(fields: [courtId],      references: [id], onDelete: Cascade)

  @@unique([tournamentId, courtId])
}

// İŞLETME TESİSİ — işletme hesabı tarafından eklenir, admin onaylar
model BusinessVenue {
  id          String   @id @default(uuid())
  userId      String
  name        String
  branch      String
  city        String
  district    String?
  address     String?
  phone       String?
  // Kullanıcı isteği: Pro olmayan (uygulama içi rezervasyon yapılamayan) tesislerde, tesisin
  // kendi online rezervasyon/web sitesine link verilebilsin — onaylanınca tesis kartında/detayında
  // dokununca direkt açılır (bkz. mobile openWebsite, VenueSearchScreen.js).
  website     String?
  openTime    String   @default("08:00")
  closeTime   String   @default("22:00")
  openSlots   Json?
  openDays    Json     @default("[1,2,3,4,5,6,7]")
  slotType              String   @default("FULL_HOUR") // FULL_HOUR | HALF_HOUR | NINETY_MIN
  pricePerSlot          Int      @default(0)           // TL cinsinden slot başı ücret
  cancelHoursBefore     Int?                           // null=her zaman, -1=asla, N>=0=N saat öncesine kadar
  rescheduleHoursBefore Int?                           // null=her zaman, -1=asla, N>=0=N saat öncesine kadar
  acceptedPayments      Json     @default("[\"CASH\",\"EFT\"]") // kabul edilen ödeme yöntemleri
  approvalMode          String   @default("FULL_AUTO")         // FULL_AUTO | EFT_TIMED | PAYMENT_AUTO | MANUAL
  courtIndoorDefault    Boolean  @default(false)            // false = açık alan, true = kapalı alan (tüm kortlar için varsayılan)
  businessIban          String?                            // EFT ödemeler için IBAN (tesis bazında)
  businessIbanHolder    String?                            // IBAN hesap sahibi adı
  pricingWindows        Json?                              // [{from,to,price,courtId?,paymentDeltas?}] saat aralığı fiyatları — paymentDeltas: {CASH,EFT,ONLINE,CREDIT_CARD} → o kuralın fiyatına eklenen sabit TL farkı (PRO+)
  discountCampaigns     Json?                              // [{id,fromTime,toTime,percent}] saat aralığı indirim kampanyaları — "şu saatler arası %şu indirim"
  loyaltyCampaign       Json?                              // {enabled,thresholdHours,rewardHours} — "ayda X saat rezervasyon yapana Y saat bedava"
  contactLinks          Json?                              // {whatsapp?,telegram?,instagram?,email?,phone?}
  reservationOpenDaysBefore Int?                           // null=sınırsız (her zaman açık); 3|5|7|10|14 = rezervasyon o tarihten N gün önce açılır
  reservationOpenTime       String?                        // HH:MM, açılış saati (null=00:00)
  lat                   Float?                             // Google Maps enlem
  lng                   Float?                             // Google Maps boylam
  status       String   @default("PENDING")   // PENDING | APPROVED | REJECTED
  adminNote   String?
  pendingEdit  Json?                              // eksik/hatalı bilgiyi tamamlamak için herhangi bir kullanıcının gönderdiği, admin onayı bekleyen alan güncellemesi — {name?,district?,address?,phone?,courtCount?,openTime?,closeTime?,openDays?,submittedBy,submittedAt}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courts       VenueCourt[]
  reservations CourtReservation[]
  blocks       VenueBlock[]
  menuItems    VenueMenuItem[]
  orders       VenueOrder[]
  bills        VenueBill[]
  reviews      VenueReview[]
  reviewAppeals ReviewAppeal[]
  loyaltyCredits VenueLoyaltyCredit[]
}

// Sadakat kampanyası kredisi — bir kullanıcının bir tesiste biriktirdiği/kazandığı bedava
// rezervasyon dakikası. Rezervasyon onaylandıkça (bkz. grantLoyaltyCreditIfEligible)
// lastGrantedPeriod ile aynı ay içinde tekrar ödül verilmesi engellenir; freeMinutes ise
// harcanana kadar aya bağlı kalmadan birikir.
model VenueLoyaltyCredit {
  id                String   @id @default(uuid())
  venueId           String
  userId            String
  freeMinutes       Int      @default(0)
  lastGrantedPeriod String?  // "2026-08"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  venue BusinessVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
}

model VenueCourt {
  id         String  @id @default(uuid())
  venueId    String
  name       String
  slotType         String?
  surface          String?
  indoor           Boolean? // null = tesis varsayılanı kullan
  lightsFrom       String?
  lightsFee        Int?     // gece ışıkları (lightsFrom) açıldıktan sonra saat başı eklenecek ek ücret — kullanıcı isteği: "ışıkları belirlediği saatten sonra kort ücretlerine +200 TL gibi ekleyebilsin"
  pricePerSlot     Int?     // null = tesis varsayılanı kullan
  maintenanceDates Json?    // [{ from: "YYYY-MM-DD", to: "YYYY-MM-DD" }]
  approvalMode     String?  // null = tesis varsayılanı kullan

  venue        BusinessVenue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservations CourtReservation[]
  reviews      VenueReview[]
}

model CourtReservation {
  id            String   @id @default(uuid())
  venueId       String
  courtId       String
  userId        String?
  manualName    String?  // userId null ise: işletmecinin telefonla girdiği müşteri adı
  date          String
  startTime     String
  endTime       String
  paymentMethod String   @default("CASH")    // EFT | CASH | ONLINE
  status        String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  noShow        Boolean  @default(false)
  receiptUrl    String?
  notes         String?
  cancelRequested     Boolean  @default(false)
  cancelRequestNote   String?
  paymentConfirmStatus String @default("PENDING") // PENDING | CONFIRMED | NOT_COLLECTED — CASH/EFT rezervasyonda saatten 30dk sonra işletmeciye sorulur
  paymentPromptSent    Boolean @default(false)    // "ödeme onayı bekleniyor" bildirimi bir kez gönderilsin diye
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  venue   BusinessVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court   VenueCourt    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId],  references: [id], onDelete: Cascade)
  bill    VenueBill?
}

// TESİS KULLANICI ENGELİ
model VenueBlock {
  id        String   @id @default(uuid())
  venueId   String
  userId    String
  createdAt DateTime @default(now())

  venue     BusinessVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user      User          @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
}

// TESİS MENÜ KALEMİ
model VenueMenuItem {
  id        String   @id @default(uuid())
  venueId   String
  name      String
  price     Int      @default(0)
  category  String   @default("OTHER") // EQUIPMENT | FOOD | DRINK | OTHER
  unit      String?  // ör: "/saat", "200g", "330ml"
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue      BusinessVenue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  orderItems VenueOrderItem[]
  billItems  VenueBillItem[]
}

// TESİS SİPARİŞİ
model VenueOrder {
  id         String   @id @default(uuid())
  venueId    String
  userId     String
  status     String   @default("PENDING") // PENDING | CONFIRMED | READY | CANCELLED
  totalPrice Int      @default(0)
  notes      String?
  activityId String?  // sipariş verildiği anda kullanıcının bu tesisteki maçı/ilanı (ActivityRequest.id)
                       // — FK değil (ActivityRequest silinirse sipariş geçmişi bozulmasın diye), işletmeci
                       // "hangi maç/oyuncu" görsün diye Sipariş sekmesinde manuel join ile gösterilir.
  delivered      Boolean  @default(false) // işletme ürünü oyuncuya fiziksel olarak teslim etti mi
  paymentStatus  String   @default("UNPAID") // UNPAID | PAID | COMPED (ikram — ücretsiz, borç sayılmaz)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  venue  BusinessVenue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId],  references: [id], onDelete: Cascade)
  items  VenueOrderItem[]
}

// SİPARİŞ KALEMİ
model VenueOrderItem {
  id         String @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int    @default(1)
  unitPrice  Int

  order    VenueOrder    @relation(fields: [orderId],    references: [id], onDelete: Cascade)
  menuItem VenueMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

// ADİSYON — rezervasyona bağlı, işletmenin manuel oluşturduğu hesap
model VenueBill {
  id            String   @id @default(uuid())
  venueId       String
  reservationId String   @unique
  status        String   @default("OPEN") // OPEN | PAID
  totalPrice    Int      @default(0)
  paidAt        DateTime?
  paymentRequestedAt DateTime? // katılımcılardan ödeme istendiği an — 2 saat sonra admine bildirim açılır
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  venue       BusinessVenue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  reservation CourtReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  items       VenueBillItem[]
}

// ADİSYON KALEMİ
model VenueBillItem {
  id         String  @id @default(uuid())
  billId     String
  menuItemId String?
  userId     String? // bu ürünü kim aldı — kullanıcı kendi sipariş verdiyse otomatik,
                      // işletmeci manuel eklerken isterse rezervasyon kadrosundan seçer
  name       String  // ekleme anındaki isim (menüden silinse de adisyonda kalır)
  unitPrice  Int     // ekleme anındaki fiyat
  quantity   Int     @default(1)
  note       String? // manuel eklenen ürünün isteğe bağlı detayı
  sourceOrderId String? // hangi VenueOrder'dan geldi (FK değil — sipariş silinse de adisyon kalemi
                        // kalsın) — aynı maça art arda gelen siparişler aynı adisyona "N. Sipariş"
                        // olarak gruplanıp gösterilsin diye (kullanıcı isteği). Manuel eklenen
                        // ürünlerde null.
  createdAt  DateTime @default(now())

  bill     VenueBill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  menuItem VenueMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// KORT BLOĞU — turnuva süresince kort rezervasyona kapalıdır
model CourtBlock {
  id           String   @id @default(uuid())
  courtId      String
  tournamentId String
  startAt      DateTime
  endAt        DateTime
  createdAt    DateTime @default(now())

  court        Court      @relation(fields: [courtId],      references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([courtId, tournamentId])
}

// TESİS / KORT YORUMU
model VenueReview {
  id        String   @id @default(uuid())
  venueId   String
  courtId   String?  // null = tesis geneli, dolu = belirli kort yorumu
  userId    String
  rating    Int      // 1–5
  comment   String?
  status    String   @default("APPROVED") // PENDING | APPROVED | REJECTED — Pro/Premium isletmelerde admin onayi gerekir, digerlerinde direkt APPROVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue   BusinessVenue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  court   VenueCourt?    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId],  references: [id], onDelete: Cascade)
  appeals ReviewAppeal[]

  @@unique([userId, venueId, courtId]) // kullanıcı başına hedef başına 1 yorum
}

model ReviewAppeal {
  id         String   @id @default(uuid())
  reviewId   String
  venueId    String
  appealerId String   // venue owner userId
  reason     String
  status     String   @default("PENDING") // PENDING | RESOLVED | REJECTED
  adminNote  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  review   VenueReview   @relation(fields: [reviewId],   references: [id], onDelete: Cascade)
  venue    BusinessVenue @relation(fields: [venueId],    references: [id], onDelete: Cascade)
  appealer User          @relation(fields: [appealerId], references: [id], onDelete: Cascade)

  @@unique([reviewId, appealerId])
}
// ARKADAŞ BULMA — AI destekli, konum bazlı eşleştirme
model FriendFindingProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  seeking          String   @default("FRIENDS")   // FRIENDS | PARTNER | BOTH
  answers          Json                              // ham anket cevapları, gizli
  aiProfile        Json?                             // Claude'un ürettiği yapılandırılmış profil, gizli
  aiProfileVersion Int      @default(1)
  active           Boolean  @default(true)
  ageMin           Int?
  ageMax           Int?
  genderPref       Json     @default("[]")
  maxDistanceKm    Int      @default(50)
  seekingFilter    String?  // FRIENDS | PARTNER | BOTH | null — opsiyonel filtre, dolarsa sadece bunu arayanlar gösterilir (anketteki kendi "seeking" cevabı artık görünürlüğü etkilemiyor, bkz. getCandidates)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendFindingSwipe {
  id        String   @id @default(uuid())
  swiperId  String
  targetId  String
  decision  String   // LIKE | PASS
  createdAt DateTime @default(now())

  swiper User @relation("FFSwiper", fields: [swiperId], references: [id], onDelete: Cascade)
  target User @relation("FFTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([targetId, decision])
}

model FriendFindingMatch {
  id            String    @id @default(uuid())
  user1Id       String
  user2Id       String
  status        String    @default("ACTIVE") // ACTIVE | UNMATCHED
  matchedAt     DateTime  @default(now())
  unmatchedAt   DateTime?
  unmatchedById String?

  user1 User @relation("FFMatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FFMatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
}
