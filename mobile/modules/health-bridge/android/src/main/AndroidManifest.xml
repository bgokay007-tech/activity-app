<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.healthbridge">
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <application>
        <!-- Health Connect, Android 14+'ta kullanıcı "Neden bu izin isteniyor?" (rationale)
             yazısına dokununca bu intent-filter'ı arar — ana Activity'ye (MainActivity)
             yönlendiren bir alias yeterli, ayrı bir ekrana gerek yok. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.activity.app.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
