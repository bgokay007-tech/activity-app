{
  "expo": {
    "name": "Activity",
    "slug": "activity-app",
    "version": "1.0.0",
    "scheme": "activityapp",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6efad865-a6d7-4da4-b5e8-43c9c4de1cba",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.activity.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.activity.app",
      "softwareKeyboardLayoutMode": "pan",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBPx1coqo46Ge1eS2b4rZ_UpCAoTcQC_KM"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6d28d9",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki rakip ilanlarını bulabilmek için konumunu kullanmak istiyoruz.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "6efad865-a6d7-4da4-b5e8-43c9c4de1cba"
      }
    },
    "owner": "burobro"
  }
}
